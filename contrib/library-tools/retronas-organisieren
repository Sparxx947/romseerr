#!/usr/bin/env python3
"""Einen RetroNAS-Plattformordner so umbauen, dass RomM, Romseerr UND RetroNAS
dasselbe darin sehen.

WARUM DAS NOETIG IST
--------------------
Alle drei lesen denselben Ordner, zaehlen aber verschieden:

  RetroNAS   stellt nur bereit — die Struktur darunter ist ihm gleich.
  RomM       nimmt JEDEN EINTRAG DER ERSTEN EBENE als genau ein Spiel.
  Romseerr   laeuft zwei Ebenen tief und nimmt jede Datei als Titel.

Deshalb sah RomM unter `c64` genau 75 "Spiele": `C64.GIF`, `BASIC.ROM` und
Sammelordner wie `OneLoad64-Games-Collection-v5` mit 27.451 Dateien darunter.
Romseerr sah in denselben Daten 23.802 Titel.

ZIELFORM — sie erfuellt alle drei zugleich:

    <plattform>/Spiel.rom              eine Datei  = ein Spiel
    <plattform>/Spiel/                 ein Ordner  = ein Spiel (Multi-Disk,
        Disk 1.d64                                   DOS-Installation, PS3-Titel)
        Disk 2.d64

Ebene 1 ist damit die Spielebene, und genau das erwartet RomM. Romseerr
kommt damit ebenso zurecht (zwei Ebenen), RetroNAS ohnehin.

WAS ES NICHT TUT
----------------
* Es benennt **keine Plattformordner um**. Die Namen stammen von RetroNAS und
  sind dessen Zuordnung; Romseerr bildet sie ueber FOLDER_ALIASES ab, RomM ueber
  `fs_slug`. Ein Umbenennen wuerde alle drei gleichzeitig entkoppeln.
* Es fasst **Beiwerk nicht an** (Bilder, Texte, PDFs) — ausdruecklich so gewollt.
* Es entpackt **keine Arcade-Romsets**. MAME und FBNeo laden ein Set als EINE
  ZIP-Datei; entpackt ist es unbrauchbar und nur neu zu beschaffen.

RUECKWEG
--------
Jede einzelne Aktion steht als JSON-Zeile im Protokoll, in der Reihenfolge der
Ausfuehrung. `--zurueck <protokoll>` spielt sie rueckwaerts zurueck. Es gibt keine
Sicherung der Bibliothek — das Protokoll IST der Rueckweg, deshalb wird es vor
der ersten Aenderung angelegt und nach jeder Aktion sofort auf die Platte
geschrieben.

    retronas-organisieren --trocken vic-20      # nur berichten, nichts anfassen
    retronas-organisieren vic-20                # umbauen
    retronas-organisieren --zurueck /roms/.umbau/vic-20-<zeit>.jsonl

`--nur-beiwerk` fuehrt allein Schritt 3c aus: Beiwerk von Ebene 1 nach `_beiwerk/`. Kein
Entpacken, keine Sammlungen, KEIN Loeschen von Dubletten — der Lauf besteht nur aus
Verschiebungen und ist deshalb als einziger restlos zuruecknehmbar.

    retronas-organisieren --trocken --nur-beiwerk --alle    # zaehlen, was betroffen waere
    retronas-organisieren --nur-beiwerk amiga               # nur diese Plattform raeumen
"""
import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time

# --------------------------------------------------------------- Regelwerk

# Plattformen, bei denen ein ORDNER ein Spiel ist und keine Sammlung: Spiele
# bestehen dort aus vielen Dateien (DOS-Installation, PS3-Titel mit PS3_GAME,
# ScummVM-Datensaetze). Ihre Ebene-1-Ordner duerfen NICHT aufgeloest werden.
ORDNER_IST_SPIEL = {
    "dos", "scummvm", "psp", "ps3", "ps2", "wii", "wiiu", "gc", "ngc",
    "switch", "xbox", "xbox360", "ps4", "psvita", "GP32", "RG350", "3ds",
}

# Plattformen, deren Archive gepackt bleiben MUESSEN. Ein MAME-/FBNeo-Romset ist
# genau eine ZIP-Datei; entpackt startet es nicht.
ARCHIV_BLEIBT = {
    "arcade", "mame", "fbneo", "neogeo", "neogeoaes", "neogeomvs", "neo-geo-cd",
    "cps1", "cps2", "cps3", "Atomiswave", "atomiswave", "stv", "naomi",
}

# Endungen, die ausgepackt werden koennen.
ARCHIV_ENDUNGEN = {".zip", ".7z", ".rar", ".lha", ".lzh", ".tar", ".gz", ".tgz"}

# Beiwerk — wird gezaehlt, aber nicht angefasst.
#
# Musik und Symbole gehoerten von Anfang an dazu und fehlten (#318). Am Bestand gemessen
# (2026-08-14), Ebene 1 — also genau das, was RomM als Spiele zaehlt:
#
#     amiga   55.102 `.sid`   37.315 `.info`   15.938 `.mod`   von 273.002 Eintraegen
#     c64      9.012 `.sid`                                    von  72.061 Eintraegen
#
# 117.366 Eintraege, mehr als die Bibliothek vor dem Umbau an Titeln hatte. Nachgesehen,
# nicht angenommen: `.info` traegt in 200 von 200 Stichproben `E3 10 00 01` (Amiga
# DiskObject — ein Workbench-Symbol zur Datei daneben), `.sid` 198x `PSID` + 2x `RSID`,
# `.mod` 175x `M.K.`/`M!K!` bei Offset 1080.
#
# Eine einzige Datei heisst buchstaeblich `.info` und bleibt liegen: `os.path.splitext`
# zaehlt den fuehrenden Punkt zum Namen, nicht zur Endung. Deshalb 108.354 statt 108.355
# unter `amiga` — genannt, weil eine unerklaerte Abweichung schlimmer ist als eine erklaerte.
#
# Dass das keine eigene Entscheidung ist, sondern eine Angleichung: `ROM_EXT` in `app.py`
# kennt keine der drei Endungen. Romseerrs Importer weist sie laengst ab; nur dieses
# Werkzeug hielt sie noch fuer Spiele. `test_no_platform_holds_its_games_in_an_ancillary_format`
# haelt die beiden Listen kuenftig gegeneinander.
#
# EN: icons and tracker/SID music were missing from this list. Romseerr's own importer
# already refuses all three extensions; this aligns the tool with it.
BEIWERK = {".jpg", ".jpeg", ".png", ".gif", ".bmp", ".txt", ".nfo", ".pdf",
           ".html", ".htm", ".doc", ".rtf", ".diz", ".sfv", ".md5", ".dat",
           ".info", ".sid", ".mod"}

# Ab wie vielen Dateien gilt ein Ordner als Sammlung und nicht als Multi-Disk-Spiel?
# Ein Spiel mit mehr als 12 Disketten ist selten; eine Sammlung hat Hunderte.
SPIEL_MAX_DATEIEN = 12

# Wohin Beiwerk von Ebene 1 wandert. Unterstrich, nicht Punkt — siehe Schritt 3c. (#399)
BEIWERK_ORDNER = "_beiwerk"

# Plattformen, auf denen eine sonst als Beiwerk geltende Endung DAS SPIELFORMAT ist.
#
# BEINAHE-SCHADEN, am Bestand gemessen (#399): PICO-8-Karten sind `.png` — `10002.p8.png`
# ist ein Spiel, kein Bild. Unter `pico8` liegen 12.629 davon, und ein Lauf haette sie
# allesamt nach `_beiwerk/` geschoben. Die Regel „Ebene 1 ist die Spielebene" haette die
# Plattform damit geleert, statt sie aufzuraeumen.
BEIWERK_AUSNAHME = {
    "pico8": {".png"},        # `.p8.png` — die Karte IST das Bild
}

# Anteil, ab dem das Einsammeln als Irrtum gilt und unterbleibt. Sind mehr als die Haelfte
# der Eintraege auf Ebene 1 „Beiwerk", stimmt nicht der Bestand, sondern die Einordnung —
# und dann ist Nichtstun die richtige Antwort. Der Fall `pico8` steht oben ausdruecklich;
# diese Schranke faengt den naechsten, den noch niemand gemessen hat.
BEIWERK_HOECHSTANTEIL = 0.5


def ist_beiwerk(name):
    return os.path.splitext(name)[1].lower() in BEIWERK


# Datentraeger-Marker: `(Disk 1)`, `(Side A)`, `[Disc 2]`, `(Tape 1 of 3)`, `(Part 2)`.
# Das ist das EINZIGE verlaessliche Zeichen dafuer, dass mehrere Dateien EIN Spiel
# sind. Ein gemeinsamer Namensanfang genuegt NICHT: `VC Songs-Cartridge - Inventio-Pac`
# und `VC Songs-Cartridge - The Mad Boogy` teilen 22 Zeichen und sind zwei
# verschiedene Demos. Am Bestand nachgemessen, nicht angenommen.
_MARKER = re.compile(
    r"[\(\[]\s*(disk|disc|side|tape|cassette|part|cd|dis[ck]ette)\s*"
    r"[\w]*\s*(of\s*\d+)?\s*[\)\]]", re.I)


def ohne_marker(name):
    """Dateiname ohne Datentraeger-Marker und Endung.

    `Cassette 50 (1983)(Cascade)(Side A).zip` -> `cassette 50 (1983)(cascade)`
    Zwei Seiten desselben Titels fallen damit zusammen, zwei verschiedene Titel
    nicht.
    """
    stamm = os.path.splitext(name)[0]
    return _MARKER.sub("", stamm).strip().lower()


# --- Abbild-Sets (Disc-Images) ---------------------------------------------------------
#
# WAS HIER SCHIEFGING (#462): Ein Dreamcast-Titel liegt als Ordner mit EINER kleinen
# Textdatei und mehreren Spurdateien vor:
#
#     Bangai-O (PAL)(M3)/Bangai-O v1.001 (2000)(Virgin)(PAL)(M3)[!].gdi
#     Bangai-O (PAL)(M3)/track01.bin   track02.raw   track03.bin
#
# `ist_spielordner` fragte, ob ALLE Dateien nach Abzug des Datentraeger-Markers denselben
# Titel ergeben. Hier sind es vier verschiedene Staemme, also „Sammlung", also flachgelegt.
# Die Spurnamen sind generisch, sie kollidierten und wurden zu `track01 (53).bin` — die
# `.gdi` verweist aber weiter auf `track01.bin`. Ergebnis: ALLE 138 Titel zeigten auf
# dieselbe Datei, gemessen am Emulator als tausende `W[GDROM]: Sector Read miss`.
#
# Die Marker-Regel ist fuer `Spiel (Disk 1).adf` richtig. Ein Abbild-Set kann sie
# grundsaetzlich nicht sehen: Dort ist die Namensgleichheit nicht nur abwesend, sie ist
# ABSICHTLICH abwesend — die Spuren heissen bei jedem Spiel gleich.
#
# Deshalb wird hier die STRUKTUR gelesen: Eine Abbildliste nennt ihre Dateien, und liegen
# die daneben, ist der Ordner ein Spiel. Kein Namensvergleich, keine Heuristik.
#
# EN: a disc-image set is one game: a small text file names its track files and those files
# sit next to it. The track names are generic on purpose, so no name-based rule can see it.
ABBILDLISTE = {".gdi", ".cue", ".m3u"}

_CUE_DATEI = re.compile(r'^\s*FILE\s+(?:"([^"]+)"|(\S+))', re.I | re.M)


def _abbild_verweise(pfad):
    """Dateinamen, die eine Abbildliste nennt. Leer, wenn sie sich nicht lesen laesst.

    `.gdi`: erste Zeile ist die Spurzahl, danach je Spur
            `<nr> <lba> <typ> <sektorgroesse> <datei> <offset>`. Der Dateiname kann
            Leerzeichen enthalten, deshalb werden vier Felder vorne und eines hinten
            abgezogen, statt auf Feld 5 zu zeigen.
    `.cue`: `FILE "name" BINARY`, mit oder ohne Anfuehrungszeichen.
    `.m3u`: je Zeile ein Verweis, `#` ist Kommentar.
    """
    endung = os.path.splitext(pfad)[1].lower()
    try:
        with open(pfad, "r", encoding="utf-8", errors="replace") as f:
            text = f.read(200_000)
    except OSError:
        return []
    namen = []
    if endung == ".gdi":
        for zeile in text.splitlines()[1:]:
            teile = zeile.split()
            if len(teile) < 6:
                continue
            namen.append(" ".join(teile[4:-1]).strip('"'))
    elif endung == ".cue":
        namen = [(a or b) for a, b in _CUE_DATEI.findall(text)]
    elif endung == ".m3u":
        namen = [z.strip() for z in text.splitlines()
                 if z.strip() and not z.lstrip().startswith("#")]
    return [os.path.basename(n) for n in namen if n]


def ist_abbild_set(pfad):
    """-> True, wenn dieser Ordner EIN Abbild-Set ist. (#462)

    Bedingungen, alle noetig:
      * mindestens eine Abbildliste auf der obersten Ebene,
      * ALLE Listen reduzieren sich nach Abzug des Datentraeger-Markers auf EINEN Titel —
        so bleibt ein Mehrfach-Disc-Spiel ein Spiel und zwei verschiedene Titel im selben
        Ordner bleiben eine Sammlung,
      * jede genannte Datei liegt tatsaechlich daneben. Fehlt eine, ist der Ordner kaputt
        oder unvollstaendig, und ihn als Einheit zu behandeln wuerde den Schaden festigen.
    """
    try:
        eintraege = [e for e in os.scandir(pfad) if e.is_file()]
    except OSError:
        return False
    listen = [e for e in eintraege
              if os.path.splitext(e.name)[1].lower() in ABBILDLISTE]
    if not listen:
        return False
    if len({ohne_marker(e.name) for e in listen}) != 1:
        return False
    vorhanden = {e.name.lower() for e in eintraege}
    genannt = []
    for e in listen:
        verweise = _abbild_verweise(e.path)
        if not verweise:
            return False          # unlesbar oder leer — nicht raten
        genannt.extend(verweise)
    return all(n.lower() in vorhanden for n in genannt)


def ist_spielordner(pfad, plattform):
    """-> True, wenn dieser Ordner EIN Spiel ist und nicht eine Sammlung.

    Vier Wege fuehren dahin, in dieser Reihenfolge:
      1. Die Plattform kennt nur Spielordner (DOS, PS3, ScummVM …).
      2. Der Ordner ist ein ABBILD-SET: eine `.gdi`/`.cue`/`.m3u` nennt Dateien, die
         daneben liegen. (#462)
      3. Der Ordner hat wenige Dateien, die sich nach Abzug des
         Datentraeger-Markers auf DENSELBEN Titel reduzieren — Multi-Disk-Spiel.
      4. Sonst: Sammlung.

    Am Bestand geprueft: `Cassette 50 …(Side A)/(Side B)` ist ein Spiel,
    fuenf `VC Songs-Cartridge - …`-Demos sind es nicht, obwohl sie 22 Zeichen
    Namensanfang teilen.
    """
    if plattform in ORDNER_IST_SPIEL:
        return True
    # VOR der Dateizahl-Schranke: Ein Abbild-Set kann mehr als SPIEL_MAX_DATEIEN Spuren
    # haben (gemessen: 38 bei `Bangai-O`), und dann waere es unter der alten Reihenfolge
    # weiterhin eine „Sammlung". (#462)
    if ist_abbild_set(pfad):
        return True
    dateien = []
    for wurzel, _d, fs in os.walk(pfad):
        dateien.extend(fs)
        if len(dateien) > SPIEL_MAX_DATEIEN:
            return False
    if not dateien:
        return False
    echte = [f for f in dateien if not ist_beiwerk(f)]
    if len(echte) < 2:
        return False
    # EIN Spiel liegt vor, wenn alle Dateien nach Abzug des Datentraeger-Markers
    # denselben Titel ergeben — und mindestens eine ueberhaupt einen Marker traegt.
    # Ohne die zweite Bedingung wuerden zwei gleichnamige Dateien mit
    # verschiedener Endung (`spiel.d64`, `spiel.tap`) als Multi-Disk gelten.
    stämme = {ohne_marker(f) for f in echte}
    return len(stämme) == 1 and any(_MARKER.search(f) for f in echte)


# WARUM `surrogateescape` (#397): Ein Dateiname ist unter Linux eine Bytefolge, kein
# Text. Namen aus Amiga- und DOS-Quellen enthalten Bytes, die kein gueltiges UTF-8
# sind; `os.listdir` liefert sie als Ersatzzeichen (`\udce0` fuer 0xE0) zurueck, und
# der Versuch, so etwas nach UTF-8 zu schreiben, wirft `UnicodeEncodeError`. Genau
# daran starb der `amiga`-Lauf — beim Schreiben der Protokollzeile, also an der
# einzigen Stelle, die den Rueckweg festhaelt. Mit `surrogateescape` wird das
# urspruengliche Byte geschrieben und beim Lesen wieder zum selben Ersatzzeichen; der
# Name geht durch das Protokoll hindurch, ohne sich zu veraendern.
PROTOKOLL_KODIERUNG = {"encoding": "utf-8", "errors": "surrogateescape"}


class Protokoll:
    """Jede Aktion sofort auf die Platte. Ein Absturz mittendrin darf den
    Rueckweg nicht kosten — deshalb kein Puffer."""

    def __init__(self, pfad, trocken):
        self.trocken = trocken
        self.pfad = pfad
        self.f = None
        if not trocken:
            os.makedirs(os.path.dirname(pfad), exist_ok=True)
            self.f = open(pfad, "a", **PROTOKOLL_KODIERUNG)

    def schreiben(self, art, **felder):
        if self.f:
            self.f.write(json.dumps({"art": art, **felder}, ensure_ascii=False) + "\n")
            self.f.flush()
            os.fsync(self.f.fileno())

    def zu(self):
        if self.f:
            self.f.close()


# Unraid-Shares gehoeren `nobody:users` (99:100). Alles, was dieses Werkzeug im
# Container als root anlegt, gehoert sonst root:root — und damit koennen RomM,
# Romseerr und der Zugriff ueber SMB die Datei zwar lesen, aber nicht mehr
# bewegen oder loeschen. Genau diese Falle hat hier schon einmal einen Emulator
# lahmgelegt (root-eigene Konfigurationsdatei, Modus 600).
SHARE_UID, SHARE_GID = 99, 100


def rechte_setzen(pfad):
    """Eigentuemer auf den Unraid-Standard ziehen. Fehler sind nicht fatal —
    laeuft das Werkzeug einmal ohne root, ist das kein Grund abzubrechen."""
    try:
        os.chown(pfad, SHARE_UID, SHARE_GID)
    except (OSError, AttributeError):
        pass


def baum_rechte_setzen(pfad):
    if os.path.isdir(pfad):
        rechte_setzen(pfad)
        for w, ds, fs in os.walk(pfad):
            for n in ds + fs:
                rechte_setzen(os.path.join(w, n))
    else:
        rechte_setzen(pfad)


def fehler_merken(z, protokoll, schritt, pfad, grund):
    """Einen Fehler zaehlen UND auffindbar machen. (#424)

    WOZU: Vorher stand am Ende einer Plattform nur `FEHLER: 3`. Drei von 62.894 Dateien
    waren schiefgegangen — und es gab keinen Weg herauszufinden, welche. Weder im
    Bildschirmprotokoll noch im JSONL stand ein Name.

    Bei den Pruefsummen ist das nicht bloss unschoen. Eine Datei ohne Pruefsumme wird beim
    Dublettenabgleich UEBERSPRUNGEN, nicht etwa entfernt: Eine echte Dublette kann also
    stehen bleiben, und niemand kann hinterher nachsehen, welche. Eine beruhigende kleine
    Zahl verdeckte drei unbekannte Dateien.

    Der Zaehler bleibt — er ist die Zusammenfassung. Dazu kommt die Zeile im Protokoll, die
    das Scrollback ueberlebt.

    EN: count the error and make it findable. A file that cannot be checksummed is skipped
    for de-duplication, so a real duplicate may survive — and nothing recorded which file.
    """
    z["fehler"] += 1
    print(f"    FEHLER [{schritt}] {pfad}: {grund}")
    protokoll.schreiben("fehler", schritt=schritt, pfad=pfad, grund=grund)


def pruefsumme(pfad, block=1 << 20):
    h = hashlib.sha256()
    with open(pfad, "rb") as f:
        while True:
            b = f.read(block)
            if not b:
                break
            h.update(b)
    return h.hexdigest()


# Zuletzt vergebener Index je (Ordner, Stamm, Endung) — siehe `freier_name`.
_freier_name_start = {}


def freier_name(ordner, name):
    """Kollisionsfreier Name im Zielordner. Gleiche Namen aus verschiedenen Sets
    sind der Normalfall, nicht die Ausnahme.

    ZWEIMAL NACHGEBESSERT (#397). Die erste Fassung suchte `range(2, 10000)` und warf
    sonst `RuntimeError: kein freier Name`. Unter `c64` liegen 9.999 Dateien
    `VERSION (i).NFO` — `VERSION.NFO` ist Beiwerk und steckt in jedem zweiten Set. Die
    Grenze beschraenkte damit nicht die Suche, sondern die Bibliothek, und riss den
    ganzen Plattformlauf ab.

    Und sie fing jedes Mal wieder bei 2 an: fuer den n-ten gleichnamigen Eintrag n
    Anfragen ans Dateisystem, ueber 9.999 Dateien rund 50 Millionen — auf einem
    Array mit drehenden Platten. Deshalb merkt sich `_freier_name_start`, wo die letzte
    Suche endete. Geprueft wird trotzdem jeder Kandidat: Der Ordner kann aus einem
    frueheren Lauf schon belegt sein, und der Vermerk gilt nur fuer diesen Prozess.
    """
    ziel = os.path.join(ordner, name)
    if not os.path.exists(ziel):
        return ziel
    stamm, endung = os.path.splitext(name)
    schluessel = (ordner, stamm, endung)
    i = _freier_name_start.get(schluessel, 2)
    while True:
        ziel = os.path.join(ordner, f"{stamm} ({i}){endung}")
        if not os.path.exists(ziel):
            _freier_name_start[schluessel] = i + 1
            return ziel
        i += 1


# Womit entpackt wird, wenn Python es nicht selbst kann. In dieser Reihenfolge, und der
# erste vorhandene gewinnt. (#447)
#
# WARUM `unar` VOR `7z`: Das p7zip aus Alpine ist OHNE den RAR-Codec gebaut — der ist
# unfrei und wird nicht mitgeliefert. Gemessen am Umbau vom 2026-08-12, allein auf `amiga`:
#
#     45 zip · 28 lzh · 7 rar · 4 lha     = 84 Archive, die geschlossen blieben
#
# Die `.rar` sind echte RAR-Dateien (`Rar!` in den ersten vier Bytes), nicht falsch
# benannte. `.lzh` und `.lha` sind auf dem Amiga das NORMALE Verteilformat — ein Archiv mit
# zwanzig Spielen zaehlt sonst als ein einziger Eintrag.
#
# `unar` kann alle vier und liegt ohnehin im Romseerr-Abbild, weil der Import-Weg es
# benutzt. Dass beide Wege Archive verschieden behandeln, war die eigentliche Ursache:
# derselbe Titel kam ueber den einen an und ueber den anderen nicht.
#
# EN: Alpine's p7zip ships without the non-free RAR codec, and lzh/lha are the normal Amiga
# distribution formats. `unar` handles all of them and is already in the Romseerr image,
# where the import path uses it — the two paths differing was the actual cause.
_ENTPACKER = (
    ("unar", lambda a, z: ["unar", "-quiet", "-force-overwrite", "-output-directory", z, a]),
    ("7z",   lambda a, z: ["7z", "x", "-y", f"-o{z}", a]),
)


def ist_ueberhaupt_ein_archiv(archiv):
    """-> True, wenn ein Entpacker den INHALT als Archiv erkennt. (#447)

    WOZU DIE UNTERSCHEIDUNG: Unter `amiga` liegen Dateien, die `.ZIP` oder `.LZH` heissen
    und keine sind — kein `PK\x03\x04`, kein LHA-Kopf, sondern Amiga-Cruncher-Formate mit
    Kennungen wie `85 15 02 41` oder `95 0a 02 41`. Sie als „Archiv liess sich nicht
    entpacken" zu melden ist doppelt falsch: Es behauptet einen Schaden, den es nicht gibt,
    und es begraebt die echten Fehlschlaege. Gemessen: 49 von 78 Meldungen waren solche
    Dateien, und darunter lagen genau ZWEI wirklich beschaedigte Archive.

    WARUM KEINE FORMATLISTE: Die Kennungen sind uneinheitlich, eine Liste waere Raterei.
    Die Frage „erkennt ein Entpacker das ueberhaupt?" ist dagegen messbar und braucht kein
    Formatwissen. `lsar` antwortet auf ein unbekanntes Format mit „Couldn't recognize the
    archive format" und einem Rueckgabewert ungleich 0.

    Im Zweifel `True`: Ist `lsar` nicht da, wird weiter wie bisher als Archiv behandelt —
    lieber ein Fehlalarm als eine still uebersprungene Datei.

    EN: distinguishes 'damaged archive' from 'not an archive at all'. Amiga cruncher files
    named .ZIP/.LZH are not archives; reporting them as failed extractions claims damage
    that does not exist and buries the two genuinely broken ones. No format list — the
    measurable question is whether any extractor recognises the content.
    """
    if not shutil.which("lsar"):
        return True
    try:
        r = subprocess.run(["lsar", archiv], capture_output=True, timeout=120)
    except Exception:
        return True
    return r.returncode == 0


def entpacken(archiv, ziel):
    """-> True bei Erfolg. Python fuer ZIP und TAR, sonst `unar` (ersatzweise `7z`)."""
    endung = os.path.splitext(archiv)[1].lower()
    os.makedirs(ziel, exist_ok=True)
    try:
        if endung == ".zip":
            import zipfile
            with zipfile.ZipFile(archiv) as z:
                z.extractall(ziel)
            return True
        if endung in (".tar", ".gz", ".tgz"):
            import tarfile
            with tarfile.open(archiv) as t:
                t.extractall(ziel)
            return True
    except Exception:
        # KEIN `return False` MEHR. Ein `.zip`, das Python ablehnt, ist nicht zwangslaeufig
        # kaputt — es kann ein falsch benanntes LHA sein, und genau das kommt in diesen
        # Bestaenden vor. Weiterreichen an ein Werkzeug, das nach dem INHALT geht, statt am
        # Namen zu scheitern. Dieselbe Lehre wie bei den 3DS-Abbildern (#422).
        # EN: a .zip Python rejects may be a misnamed LHA; hand it to a tool that reads the
        # content instead of failing on the name.
        pass
    for name, befehl in _ENTPACKER:
        if not shutil.which(name):
            continue
        try:
            r = subprocess.run(befehl(archiv, ziel), capture_output=True, timeout=1800)
            if r.returncode == 0:
                return True
        except Exception:
            continue
    return False


def beiwerk_einsammeln(basis, plattform, arcade, trocken, protokoll, z):
    """Schritt 3c: Beiwerk von Ebene 1 in `_beiwerk/` raeumen.

    WARUM (#399): Ebene 1 ist die SPIELEBENE — RomM zaehlt dort jeden Eintrag als genau
    ein Spiel. Unter `c64` standen dadurch 10.018 `.nfo`, 1.871 `.svg` und weiteres
    Beiwerk als „Spiele": 10.726 von 57.615 Eintraegen, fast jeder fuenfte.

    Jens' Entscheidung (Weg 2): in einen eigenen Unterordner statt loeschen oder liegen
    lassen. Ein Ordner mehr auf Ebene 1 statt zehntausend Dateien, und nichts geht
    verloren — wer die Textdatei zu einem Spiel sucht, findet sie weiterhin.

    Der Name beginnt mit einem UNTERSTRICH, nicht mit einem Punkt: Ein versteckter
    Ordner waere fuer Romseerr unsichtbar (#321), aber RomM zaehlt ihn trotzdem — und
    sichtbar zu sein ist hier richtig, es ist kein Werkzeugverzeichnis.

    Eigene Funktion seit #318, damit `--nur-beiwerk` genau diesen Schritt allein
    ausfuehren kann — er ist der einzige, der ohne Rest zurueckzunehmen ist.

    Level 1 is the game level; ancillary files were counted as games there. They move
    into one folder rather than being deleted or left in place.
    """
    if arcade:
        return
    beiwerk_ziel = os.path.join(basis, BEIWERK_ORDNER)
    ausnahme = BEIWERK_AUSNAHME.get(plattform, set())
    oben = [f for f in sorted(os.listdir(basis)) if f != BEIWERK_ORDNER]
    kandidaten = [f for f in oben
                  if os.path.isfile(os.path.join(basis, f))
                  and ist_beiwerk(f)
                  and os.path.splitext(f)[1].lower() not in ausnahme]
    # Wenn die Haelfte oder mehr „Beiwerk" waere, ist die Einordnung falsch, nicht der
    # Bestand. Lieber nichts tun und es sagen.
    if oben and len(kandidaten) / len(oben) > BEIWERK_HOECHSTANTEIL:
        print(f"    Beiwerk NICHT eingesammelt: {len(kandidaten)} von {len(oben)} "
              f"Eintraegen waeren betroffen — Einordnung pruefen")
        kandidaten = []
    for f in kandidaten:
        q = os.path.join(basis, f)
        if trocken:
            z["beiwerk_gesammelt"] += 1
            continue
        if not os.path.isdir(beiwerk_ziel):
            os.makedirs(beiwerk_ziel, exist_ok=True)
            rechte_setzen(beiwerk_ziel)
            # DEN ORDNER MITPROTOKOLLIEREN (#318): Ohne diese Zeile laesst `--zurueck`
            # ein leeres `_beiwerk/` stehen — und RomM zaehlt es als ein Spiel. Der
            # Rueckweg waere dann fast, aber eben nicht ganz vollstaendig, und zwar auf
            # jeder angefassten Plattform einzeln.
            protokoll.schreiben("ordner_angelegt", pfad=beiwerk_ziel)
        ziel = freier_name(beiwerk_ziel, f)
        shutil.move(q, ziel)
        rechte_setzen(ziel)
        protokoll.schreiben("verschoben", von=q, nach=ziel)
        z["beiwerk_gesammelt"] += 1


def umbauen(wurzel, plattform, trocken, protokoll, nur_beiwerk=False):
    basis = os.path.join(wurzel, plattform)
    if not os.path.isdir(basis):
        print(f"  {plattform}: gibt es nicht", file=sys.stderr)
        return 1

    z = {"entpackt": 0, "archiv_behalten": 0, "verschoben": 0, "spielordner": 0,
         "dubletten": 0, "beiwerk": 0, "fehler": 0, "befreit": 0, "satz_verschont": 0,
         "kein_archiv": 0,
         "beiwerk_gesammelt": 0}
    arcade = plattform in ARCHIV_BLEIBT

    # ---- NUR Schritt 3c ----------------------------------------------------
    # WOZU (#318): Der Umbau als Ganzes entpackt Archive und LOESCHT Dubletten. Beides ist
    # aus dem Protokoll nicht zurueckzuholen — `zurueck` sagt das selbst. Auf `amiga` ist
    # ein voller Lauf ausserdem ein Langlauf ueber 440.000 Dateien.
    #
    # Einzusammeln ist aber genau EIN Schritt, und der besteht ausschliesslich aus
    # `shutil.move`. Ein solcher Lauf schreibt nur `verschoben`- und
    # `ordner_angelegt`-Zeilen, und `--zurueck` stellt daraus den Ausgangsstand
    # vollstaendig wieder her. Deshalb ist er einzeln aufrufbar.
    #
    # EN: the full rebuild unpacks archives and deletes duplicates, neither of which the
    # log can undo. Collecting ancillary files is moves only, so it is fully reversible
    # and can be run on its own.
    if nur_beiwerk:
        beiwerk_einsammeln(basis, plattform, arcade, trocken, protokoll, z)
        art = "TROCKEN" if trocken else "AUSGEFUEHRT"
        print(f"\n  === {plattform} (NUR BEIWERK, {art}) ===")
        print(f"    Beiwerk eingesammelt  : {z['beiwerk_gesammelt']}  "
              f"(-> {BEIWERK_ORDNER}/)")
        return 0

    # ---- Schritt 1: Archive entpacken -------------------------------------
    # Zuerst, damit ihr Inhalt danach wie jede andere Datei einsortiert wird.
    if not arcade:
        archive = []
        for w, _d, fs in os.walk(basis):
            for f in fs:
                if os.path.splitext(f)[1].lower() in ARCHIV_ENDUNGEN:
                    archive.append(os.path.join(w, f))
        for a in archive:
            # DAS ENTPACKZIEL BRAUCHT EINEN FREIEN NAMEN — als einzige Stelle im Werkzeug
            # ging es bisher ohne. (#442)
            #
            # `Kolumbus.rar` soll nach `Kolumbus` entpackt werden, und auf `amiga` liegt
            # daneben eine DATEI namens `Kolumbus` (endungslos, dort voellig normal).
            # `os.makedirs(ziel, exist_ok=True)` verzeiht nur ein vorhandenes VERZEICHNIS;
            # gegen eine gleichnamige Datei wirft es `FileExistsError` — und die Ausnahme
            # reisst den ganzen Plattformlauf ab.
            #
            # DER GRUND, WARUM ES SICH NIE VON SELBST LOESTE: Der erste Durchlauf hebt die
            # Datei auf Ebene 1, das Archiv liegt noch da. Der naechste Lauf beginnt die
            # Plattform von vorn, kommt hierher und kollidiert wieder. `amiga` ist daran
            # dreimal gescheitert, zweimal ohne erkennbaren aeusseren Anlass.
            #
            # Der Ordnername ist beliebig: Sein Inhalt wird gleich danach auf Ebene 1
            # gehoben. Ein freier Name kostet also nichts und nimmt die zweite Falle mit —
            # Reste eines abgebrochenen Entpackens mischen sich nicht mehr unter den neuen
            # Inhalt.
            #
            # EN: the extraction target was the one path not going through freier_name.
            # makedirs(exist_ok=True) only forgives an existing directory; against a
            # same-named file it raises and takes the whole platform down. On resume it
            # happens again every time, so the platform could never finish.
            ziel = freier_name(os.path.dirname(a),
                               os.path.basename(os.path.splitext(a)[0]))
            if trocken:
                z["entpackt"] += 1
                continue
            if entpacken(a, ziel):
                baum_rechte_setzen(ziel)
                protokoll.schreiben("entpackt", archiv=a, ziel=ziel)
                os.remove(a)
                z["entpackt"] += 1
            else:
                shutil.rmtree(ziel, ignore_errors=True)
                # ZWEI VERSCHIEDENE BEFUNDE, NICHT EINER. (#447)
                #
                # „Beschaedigtes Archiv" und „gar kein Archiv" verlangen verschiedene
                # Antworten: das eine neu beschaffen, das andere nur richtig benennen. Sie
                # in einen Topf zu werfen behauptet Schaden, den es nicht gibt, und
                # begraebt die echten Faelle. Gemessen: 49 von 78 Meldungen waren
                # Amiga-Cruncher-Dateien mit lugender Endung, darunter genau ZWEI wirklich
                # beschaedigte Archive.
                if ist_ueberhaupt_ein_archiv(a):
                    fehler_merken(z, protokoll, "entpacken", a,
                                  "Archiv liess sich nicht entpacken")
                else:
                    z["kein_archiv"] += 1
                    protokoll.schreiben("kein_archiv", pfad=a)
    else:
        for w, _d, fs in os.walk(basis):
            z["archiv_behalten"] += sum(
                1 for f in fs if os.path.splitext(f)[1].lower() in ARCHIV_ENDUNGEN)

    # ---- Schritt 2: Sammlungen aufloesen ----------------------------------
    # Jeder Ebene-1-Ordner ist entweder EIN Spiel (bleibt) oder eine Sammlung
    # (ihr Inhalt wandert auf Ebene 1).
    for eintrag in sorted(os.listdir(basis)):
        if eintrag.startswith("."):
            continue
        p = os.path.join(basis, eintrag)
        if not os.path.isdir(p):
            continue
        if ist_spielordner(p, plattform):
            z["spielordner"] += 1
            continue
        # Sammlung: alles darunter auf Ebene 1 heben. Unterordner, die selbst
        # ein Spiel sind, wandern als GANZES — sonst zerfaellt ein Multi-Disk-
        # Spiel in lose Disketten.
        for w, unter, fs in os.walk(p, topdown=True):
            behalten = []
            for u in list(unter):
                up = os.path.join(w, u)
                if ist_spielordner(up, plattform):
                    if trocken:
                        z["verschoben"] += 1
                    else:
                        ziel = freier_name(basis, u)
                        shutil.move(up, ziel)
                        baum_rechte_setzen(ziel)
                        protokoll.schreiben("verschoben", von=up, nach=ziel)
                        z["verschoben"] += 1
                else:
                    behalten.append(u)
            unter[:] = behalten
            for f in fs:
                q = os.path.join(w, f)
                if trocken:
                    z["beiwerk" if ist_beiwerk(f) else "verschoben"] += 1
                    continue
                ziel = freier_name(basis, f)
                shutil.move(q, ziel)
                rechte_setzen(ziel)
                protokoll.schreiben("verschoben", von=q, nach=ziel)
                z["beiwerk" if ist_beiwerk(f) else "verschoben"] += 1
        if not trocken:
            # Der leere Rest der Sammlung. rmtree statt rmdir: es bleiben leere
            # Unterordner zurueck, und die sind kein Inhalt.
            shutil.rmtree(p, ignore_errors=True)
            protokoll.schreiben("leerer_ordner_entfernt", pfad=p)
            z["befreit"] += 1

    # ---- Schritt 3a: doppelte SPIELORDNER ----------------------------------
    # Dasselbe Multi-Disk-Spiel liegt oft in mehreren Sets. Beim Anheben auf
    # Ebene 1 bekommt das zweite ein " (2)" und bleibt sonst unangetastet — die
    # Dateipruefung unten sieht Ordner naemlich gar nicht. Am Bestand aufgefallen:
    # `Kraals Kingdom (1983)(Buntasoft)[16k]` stand nach dem Lauf zweimal da,
    # mit bitgleichem Inhalt.
    ordner_sig = {}
    for e in sorted(os.listdir(basis)):
        p = os.path.join(basis, e)
        if not os.path.isdir(p) or e.startswith("."):
            continue
        try:
            teile = []
            for w, _d, fs in os.walk(p):
                for f in sorted(fs):
                    teile.append(pruefsumme(os.path.join(w, f)))
            sig = hashlib.sha256("".join(sorted(teile)).encode()).hexdigest()
        except OSError as e:
            # NICHT NUR ZAEHLEN: Ein Ordner ohne Pruefsumme wird beim Dublettenabgleich
            # UEBERSPRUNGEN. Eine echte Dublette kann so stehen bleiben — und ohne den
            # Namen findet das hinterher niemand mehr. (#424)
            fehler_merken(z, protokoll, "ordner_pruefsumme", p, e.strerror or str(e))
            continue
        if sig in ordner_sig:
            if trocken:
                z["dubletten"] += 1
            else:
                shutil.rmtree(p, ignore_errors=True)
                protokoll.schreiben("dublette_ordner_entfernt", pfad=p,
                                    gleich_wie=ordner_sig[sig], sig=sig)
                z["dubletten"] += 1
        else:
            ordner_sig[sig] = p

    # ---- Schritt 3b: doppelte Dateien --------------------------------------
    # NUR bei bitgleichem Inhalt (SHA-256). Gleiche Namen sind kein Kriterium:
    # zwei Fassungen desselben Titels sind verschiedene Dateien.
    #
    # WAS EINE ABBILDLISTE NENNT, IST TABU. (#467)
    #
    # Bei CD-Titeln ist Spur 01 haeufig bei vielen Spielen BITGLEICH — eine leere
    # Datenspur oder ein Kopierschutzhinweis. Diese Stelle hat daraufhin genau das getan,
    # was sie sollte, und dabei Spiele zerstoert:
    #
    #   dublette_entfernt  turbografx-cd/Monster Lair (USA) (Track 01).bin
    #                      gleich_wie  turbografx-cd/Valis II (USA) (Track 01).bin
    #
    # Zwei verschiedene Spiele. Danach nennt Monster Lairs `.cue` eine Datei, die es nicht
    # mehr gibt. Unter `dc` sind so 375 Dateien geloescht worden, weshalb von 213 Titeln
    # nur 13 aus dem Protokoll rekonstruierbar sind: der Rest ist weg, nicht verlegt.
    #
    # Bitgleichheit macht zwei Spuren NICHT austauschbar. Jeder Satz braucht sein eigenes
    # Exemplar.
    #
    # EN: on CD titles track 01 is often bit-identical across many games, so deduplication
    # took one game's track away and left it with another. Identical content does not make
    # set members interchangeable.
    gehoert_zu_satz = set()
    for f in os.listdir(basis):
        if os.path.splitext(f)[1].lower() in ABBILDLISTE:
            for n in _abbild_verweise(os.path.join(basis, f)):
                gehoert_zu_satz.add(os.path.basename(n).lower())

    nach_groesse = {}
    for f in os.listdir(basis):
        p = os.path.join(basis, f)
        if not os.path.isfile(p) or ist_beiwerk(f):
            continue
        if f.lower() in gehoert_zu_satz:
            z["satz_verschont"] += 1
            continue
        nach_groesse.setdefault(os.path.getsize(p), []).append(p)
    for groesse, gruppe in nach_groesse.items():
        if len(gruppe) < 2:
            continue                      # gleiche Groesse ist Vorbedingung
        gesehen = {}
        for p in sorted(gruppe, key=lambda x: (len(os.path.basename(x)), x)):
            try:
                s = pruefsumme(p)
            except OSError as e:
                # Dasselbe wie oben, eine Ebene tiefer: unlesbar heisst hier NICHT
                # „geloescht", sondern „nicht verglichen". (#424)
                fehler_merken(z, protokoll, "datei_pruefsumme", p, e.strerror or str(e))
                continue
            if s in gesehen:
                # Behalten wird der KUERZESTE Name — die Fassung ohne
                # Set-Anhaengsel wie " (2)" oder "[OneLoad]".
                if trocken:
                    z["dubletten"] += 1
                else:
                    os.remove(p)
                    protokoll.schreiben("dublette_entfernt", pfad=p,
                                        gleich_wie=gesehen[s], sha256=s)
                    z["dubletten"] += 1
            else:
                gesehen[s] = p

    beiwerk_einsammeln(basis, plattform, arcade, trocken, protokoll, z)

    art = "TROCKEN" if trocken else "AUSGEFUEHRT"
    print(f"\n  === {plattform} ({art}) ===")
    print(f"    Archive entpackt      : {z['entpackt']}")
    if arcade:
        print(f"    Archive BEHALTEN      : {z['archiv_behalten']}  (Arcade-Romsets)")
    print(f"    auf Ebene 1 gehoben   : {z['verschoben']}")
    print(f"    davon Beiwerk         : {z['beiwerk']}")
    print(f"    Spielordner belassen  : {z['spielordner']}")
    if z["kein_archiv"]:
        # NICHT UNTER „Fehler" ZAEHLEN, aber auch nicht verschweigen: Diese Dateien tragen
        # eine luegende Endung und gehoeren umbenannt, nicht neu beschafft. (#447)
        print(f"    kein Archiv           : {z['kein_archiv']}  (Endung luegt — kein "
              f"Entpacker erkennt den Inhalt, KEIN Schaden)")
    if z["satz_verschont"]:
        # LAUT SAGEN, WARUM DIE ZAHL KLEINER IST. Ohne diese Zeile saehe der Lauf einfach
        # nach „weniger Dubletten" aus, und niemand wuesste, dass hier eine Regel griff.
        print(f"    Satzdateien verschont : {z['satz_verschont']}  (von Abbildlisten "
              f"genannt, nie als Dublette geloescht — #467)")
    print(f"    Dubletten entfernt    : {z['dubletten']}")
    print(f"    Sammlungen aufgeloest : {z['befreit']}")
    print(f"    Beiwerk eingesammelt  : {z['beiwerk_gesammelt']}  (-> {BEIWERK_ORDNER}/)")
    if z["fehler"]:
        print(f"    FEHLER                : {z['fehler']}")
    return 0


def zurueck(protokoll_pfad):
    """Rueckwaerts durch das Protokoll. Entpacktes wird geloescht, Verschobenes
    zurueckgelegt. Entfernte Dubletten sind NICHT wiederherstellbar — sie waren
    bitgleiche Kopien, das Original steht noch da."""
    # Dieselbe Kodierung wie beim Schreiben (#397) — sonst waere das Protokoll fuer genau
    # die Namen unlesbar, um derentwillen es angepasst wurde.
    with open(protokoll_pfad, **PROTOKOLL_KODIERUNG) as f:
        zeilen = [json.loads(z) for z in f if z.strip()]
    n = {"verschoben": 0, "entpackt": 0, "ordner": 0, "uebersprungen": 0}
    for e in reversed(zeilen):
        art = e["art"]
        try:
            if art == "verschoben":
                os.makedirs(os.path.dirname(e["von"]), exist_ok=True)
                shutil.move(e["nach"], e["von"])
                n["verschoben"] += 1
            elif art == "entpackt":
                shutil.rmtree(e["ziel"], ignore_errors=True)
                n["entpackt"] += 1        # das Archiv selbst ist weg
            elif art == "ordner_angelegt":
                # RUECKWAERTS heisst: die Zeile kommt NACH allen Verschiebungen dran, der
                # Ordner ist dann leer. `rmdir` statt `rmtree` ist Absicht — liegt doch
                # noch etwas darin, gehoert es jemand anderem, und dann bleibt der Ordner
                # stehen statt fremden Inhalt mitzunehmen.
                os.rmdir(e["pfad"])
                n["ordner"] += 1
            else:
                n["uebersprungen"] += 1
        except Exception:
            n["uebersprungen"] += 1
    print(f"  zurueckgelegt: {n['verschoben']}, entpackte Ordner entfernt: "
          f"{n['entpackt']}, leere Sammelordner entfernt: {n['ordner']}, "
          f"uebersprungen: {n['uebersprungen']}")
    print("  HINWEIS: entpackte Archive sind nicht wiederhergestellt — der "
          "Inhalt wurde entfernt, die Quelldatei war bereits geloescht.")
    return 0


def dateien_zaehlen(pfad):
    n = 0
    for _w, _d, fs in os.walk(pfad):
        n += len(fs)
    return n


def stand_laden(stand_datei):
    """Fruehere Fortschrittsdatei lesen -> (erledigte Plattformen, war_unterbrochen).

    WARUM DAS NOETIG WURDE (#371): Die Datei wurde geschrieben und NIE gelesen. Ein Lauf
    ueber diese Bibliothek dauert ueber 19 Stunden; stirbt er, fing er wieder bei der
    ersten Plattform an. Der einzige Rueckweg war `--ausser` mit einer von Hand aus den
    Protokollen zusammengesuchten Liste — ausgerechnet in dem Moment, in dem gerade ein
    Auftrag abgestuerzt ist.

    Ein FERTIGER Lauf zaehlt nicht als Wiederaufsetzpunkt: Wer nach dem Ende erneut
    startet, will neu bauen, nicht nichts tun.

    UNBRAUCHBAR IST UNBRAUCHBAR, EGAL WORAN (#583): Kaputtes JSON wurde hier immer
    verziehen, gueltiges JSON in falscher FORM dagegen riss den Lauf mit einem
    Traceback ab — `{"erledigt": ["c64"]}` genuegte. Dieselbe Datei, dieselbe Absicht,
    zwei verschiedene Ausgaenge. Die Form hat schon einmal gewechselt (#371/#372
    fuehrten das Lesen ueberhaupt erst ein); bleibt dann eine Datei der alten Fassung
    liegen, blockiert sie jeden weiteren Lauf. Und wer von Hand eine Plattform
    ueberspringen will, schreibt am ehesten genau die Kurzform oben.

    Verworfen wird laut, nicht still: Ein stumm ignorierter Wiederaufsetzpunkt sieht
    aus wie ein Neuanfang aus freien Stuecken und kostet den ganzen Lauf.

    EN: an unusable progress file is ignored the same way whatever the reason —
    unparsable JSON or valid JSON in an unexpected shape — and says so.
    """
    try:
        with open(stand_datei, encoding="utf-8") as f:
            alt = json.load(f)
    except (OSError, ValueError):
        return set(), False

    def unbrauchbar(grund):
        print(f"  {os.path.basename(stand_datei)} wird uebergangen ({grund}). "
              f"Der Lauf faengt von vorn an.")
        return set(), False

    if not isinstance(alt, dict):
        return unbrauchbar(f"erwartet wurde ein Objekt, gelesen wurde {type(alt).__name__}")
    if alt.get("fertig"):
        return set(), False
    roh = alt.get("erledigt") or []
    if not isinstance(roh, list):
        return unbrauchbar(f"'erledigt' ist {type(roh).__name__}, erwartet wird eine Liste")
    # Je Eintrag pruefen statt die ganze Datei zu verwerfen: Ein einzelner kaputter
    # Eintrag darf die uebrigen 75 Plattformen nicht kosten. Weichen ALLE ab, bleibt
    # `erledigt` leer — dann ist die Meldung faellig, sonst faengt der Lauf still
    # von vorn an.
    erledigt = {e["plattform"] for e in roh
                if isinstance(e, dict) and e.get("plattform")}
    if roh and not erledigt:
        return unbrauchbar(f"kein Eintrag in 'erledigt' nennt eine Plattform "
                           f"({len(roh)} gelesen)")
    return erledigt, bool(erledigt or alt.get("aktuell"))


def protokoll_pfad(wurzel, plattform, nur_beiwerk=False):
    """Der Name sagt, welcher Art der Lauf war — `--zurueck` bekommt ihn genannt.

    Ein Protokoll aus `--nur-beiwerk` enthaelt ausschliesslich Verschiebungen und laesst
    sich restlos zuruecknehmen; eines aus einem vollen Lauf nicht. Wer zwischen zwanzig
    Dateien in `.umbau/` steht, soll das am Namen sehen und nicht am Inhalt.
    """
    marke = "-beiwerk" if nur_beiwerk else ""
    return os.path.join(wurzel, ".umbau",
                        f"{plattform}{marke}-{time.strftime('%Y%m%d-%H%M%S')}.jsonl")


def ebene1_zaehlen(pfad):
    """Nur die erste Ebene — die Arbeitsmenge von `--nur-beiwerk`.

    `dateien_zaehlen` laeuft durch den ganzen Baum. Fuer einen Lauf, der ausschliesslich
    Ebene 1 anfasst, kostet das mehr als die Arbeit selbst: unter `amiga` sind es 440.000
    Dateien statt 273.002 Eintraegen, und die Zahl dient nur der Reihenfolge.
    """
    try:
        return len(os.listdir(pfad))
    except OSError:
        return 0


def alle_umbauen(wurzel, trocken, ueberspringen, neu_anfangen=False, nur_beiwerk=False):
    """Jede Plattform mit Inhalt, KLEINSTE ZUERST.

    Die Reihenfolge ist Absicht: die kleinen sind in Minuten durch, und wenn die
    Regeln irgendwo danebenliegen, faellt das an zwanzig kleinen Ordnern auf,
    bevor `amiga` mit seinen 440.000 Dateien laeuft.

    Der Fortschritt steht in `<wurzel>/.umbau/fortschritt.json` — er ueberlebt das
    Ende der SSH-Sitzung und ist die Grundlage fuer die Restzeitschaetzung.
    """
    # EIGENE FORTSCHRITTSDATEI FUER `--nur-beiwerk` (#318). Beide Laufarten teilen sich
    # sonst `fortschritt.json`, und dann gilt eine Plattform, die nur eingesammelt wurde,
    # als vollstaendig umgebaut: Ein spaeterer `--alle`-Lauf ueberspraenge sie, ohne je
    # ein Archiv entpackt zu haben. Der Wiederaufsetzpunkt darf nur Laeufe derselben Art
    # vergleichen.
    stand_datei = os.path.join(wurzel, ".umbau",
                               "fortschritt-beiwerk.json" if nur_beiwerk
                               else "fortschritt.json")
    # NUR fuer einen echten Lauf anlegen (#581). Sonst stirbt `--trocken --alle` gegen
    # eine schreibgeschuetzt eingehaengte Bibliothek hier, bevor es die erste Plattform
    # gesehen hat — ausgerechnet der vorsichtigste Weg, das Werkzeug auszuprobieren.
    if not trocken:
        os.makedirs(os.path.dirname(stand_datei), exist_ok=True)

    frueher, unterbrochen = (set(), False) if neu_anfangen else stand_laden(stand_datei)
    if unterbrochen:
        # LAUT SAGEN, was uebersprungen wird. Ein Wiederaufsetzen, das stillschweigend
        # weniger tut als verlangt, ist derselbe Fehler in Gruen.
        print(f"  Fortsetzung: {len(frueher)} Plattformen sind laut "
              f"{os.path.basename(stand_datei)} schon durch und werden uebersprungen.")
        print("  Alles neu bauen: --neu")

    kandidaten = []
    for e in sorted(os.listdir(wurzel)):
        p = os.path.join(wurzel, e)
        if not os.path.isdir(p) or e.startswith("."):
            continue
        if e in ueberspringen or e in frueher:
            continue
        n = ebene1_zaehlen(p) if nur_beiwerk else dateien_zaehlen(p)
        if n:
            kandidaten.append((n, e))
    kandidaten.sort()

    # Die beim Abbruch LAUFENDE Plattform steht nicht in `erledigt` und ist damit wieder
    # dabei. Absicht: Mitten in einer Plattform wieder aufzusetzen braeuchte einen Stand je
    # Eintrag; der Durchlauf ist dagegen weitgehend wiederholbar — was schon die richtige
    # Form hat, wird ohnehin nicht angefasst. Der Preis ist ein erneuter Durchgang, nicht
    # doppelte Arbeit.
    gesamt = sum(n for n, _e in kandidaten)
    # Die frueheren Eintraege MITNEHMEN. Sonst kennt ein zweiter Abbruch nur die
    # Plattformen des zweiten Laufs, und der dritte faengt wieder bei den ersten an —
    # der Fehler waere nur eine Runde weiter gewandert.
    # Dieselbe Datei ein zweites Mal, und derselbe Wachposten (#583): `json.load(f).get`
    # stirbt an einem JSON-Array genauso wie oben. Erreichbar ist das hier nur, wenn
    # `stand_laden` gerade Eintraege gefunden hat — aber der Wachposten kostet nichts
    # und die Stelle darf nicht die einzige bleiben, die es nicht kann.
    vorher = []
    if frueher:
        try:
            with open(stand_datei, encoding="utf-8") as f:
                gelesen = json.load(f)
            roh = gelesen.get("erledigt") if isinstance(gelesen, dict) else None
            vorher = [e for e in (roh or []) if isinstance(e, dict) and e.get("plattform")]
        except (OSError, ValueError):
            vorher = []

    stand = {"start": time.time(), "gesamt_dateien": gesamt,
             "plattformen_gesamt": len(kandidaten) + len(frueher),
             "erledigt": vorher, "fehlgeschlagen": [],
             "aktuell": None, "fertig": False, "offen_dateien": gesamt}

    def sichern():
        # EIN TROCKENLAUF HINTERLAESST NICHTS (#581). `Protokoll` beachtet `trocken` seit
        # jeher, diese Datei tat es nicht — und sie ist seit #372 der Wiederaufsetzpunkt.
        # Gemessen wurden zwei Schaeden: Ein ABGEBROCHENER Trockenlauf liess den spaeteren
        # echten Lauf Plattformen ueberspringen, die nie angefasst wurden. Ein
        # DURCHGELAUFENER ueberschrieb den Wiederaufsetzpunkt eines abgestuerzten echten
        # Laufs und hakte ihn als `fertig` ab — danach faengt der Umbau bei Null an, ueber
        # 19 Stunden.
        #
        # GELESEN wird der Stand weiterhin (`stand_laden` oben): Der Trockenlauf ist die
        # Vorschau auf den echten Lauf, und der setzt fort. Eine Vorschau, die mehr Arbeit
        # zeigt als anfiele, waere genauso falsch wie eine, die zu wenig zeigt.
        if trocken:
            return
        with open(stand_datei, "w", encoding="utf-8") as f:
            json.dump(stand, f, ensure_ascii=False, indent=1)
        rechte_setzen(stand_datei)

    sichern()
    print(f"  {len(kandidaten)} Plattformen, {gesamt} Dateien — kleinste zuerst\n")

    for n, e in kandidaten:
        stand["aktuell"] = {"plattform": e, "dateien": n, "seit": time.time()}
        sichern()
        t0 = time.time()
        pfad = protokoll_pfad(wurzel, e, nur_beiwerk)
        prot = Protokoll(pfad, trocken)
        fehler = None
        try:
            rc = umbauen(wurzel, e, trocken, prot, nur_beiwerk)
            if rc:
                fehler = f"Rueckgabewert {rc}"
        except Exception as ex:                    # eine Plattform darf den Lauf
            fehler = f"{ex.__class__.__name__}: {ex}"                # nicht beenden
            print(f"  {e}: FEHLER {fehler}")
        finally:
            prot.zu()
        # Eigentuemer geradeziehen: alles, was hier als root entstand, gehoert
        # sonst root:root und ist fuer RomM/Romseerr/SMB unbeweglich.
        baum_rechte_setzen(os.path.join(wurzel, e))
        # NUR was ohne Ausnahme durchlief, gilt als erledigt (#397). Weiterzumachen ist
        # richtig — ein unlesbarer Ordner darf keine 19 Stunden kosten. Den Fehlschlag als
        # `erledigt` zu buchen ist es nicht: Seit #372 IST diese Liste der
        # Wiederaufsetzpunkt, ein Fortsetzen ueberspraenge sonst genau die
        # Plattformen, die nicht fertig sind. Genau so meldete der Lauf vom 2026-08-11
        # `ALLE 74 PLATTFORMEN FERTIG`, waehrend `c64` und `amiga` abgestuerzt waren.
        if fehler:
            stand["fehlgeschlagen"].append({"plattform": e, "dateien": n,
                                            "fehler": fehler})
        else:
            stand["erledigt"].append({"plattform": e, "dateien": n,
                                      "sekunden": round(time.time() - t0, 1)})
            stand["offen_dateien"] -= n
        stand["aktuell"] = None
        sichern()

    gescheitert = stand["fehlgeschlagen"]
    # `fertig` schaltet den Wiederaufsetzpunkt ab (`stand_laden`). Nach einem Lauf mit
    # Fehlern darf es nicht stehen, sonst begaenne der naechste Aufruf wieder von vorn und
    # die zwei offenen Plattformen waeren nur ueber `--ausser` von Hand erreichbar.
    stand["fertig"] = not gescheitert
    stand["ende"] = time.time()
    sichern()
    if gescheitert:
        namen = ", ".join(f["plattform"] for f in gescheitert)
        print(f"\n  === {len(kandidaten) - len(gescheitert)} VON {len(kandidaten)} "
              f"PLATTFORMEN FERTIG, {len(gescheitert)} MIT FEHLER: {namen} ===")
        for f in gescheitert:
            print(f"    {f['plattform']}: {f['fehler']}")
        print("  Erneut versuchen: derselbe Aufruf setzt genau bei diesen fort.")
    else:
        print(f"\n  === ALLE {len(kandidaten)} PLATTFORMEN FERTIG ===")
    return 1 if gescheitert else 0


def main():
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("plattform", nargs="?", help="Ordnername unter <wurzel>")
    p.add_argument("--neu", action="store_true",
                   help="von vorn beginnen statt fortzusetzen (verwirft den Fortschritt)")
    p.add_argument("--alle", action="store_true",
                   help="alle Plattformen mit Inhalt, kleinste zuerst")
    p.add_argument("--ausser", default="",
                   help="Komma-Liste bereits erledigter Plattformen")
    p.add_argument("--wurzel", default="/roms")
    p.add_argument("--trocken", action="store_true", help="nur berichten")
    p.add_argument("--nur-beiwerk", action="store_true", dest="nur_beiwerk",
                   help="NUR Beiwerk von Ebene 1 einsammeln — nicht entpacken, keine "
                        "Sammlungen aufloesen, keine Dubletten loeschen (restlos "
                        "ueber --zurueck ruecknehmbar)")
    p.add_argument("--zurueck", metavar="PROTOKOLL", help="Umbau rueckgaengig machen")
    a = p.parse_args()

    if a.zurueck:
        return zurueck(a.zurueck)
    if a.alle:
        ueber = {x.strip() for x in a.ausser.split(",") if x.strip()}
        return alle_umbauen(a.wurzel, a.trocken, ueber, a.neu, a.nur_beiwerk)
    if not a.plattform:
        p.error("Plattform fehlt")

    pfad = protokoll_pfad(a.wurzel, a.plattform, a.nur_beiwerk)
    prot = Protokoll(pfad, a.trocken)
    try:
        rc = umbauen(a.wurzel, a.plattform, a.trocken, prot, a.nur_beiwerk)
    finally:
        prot.zu()
    if not a.trocken:
        print(f"    Protokoll             : {pfad}")
    return rc


if __name__ == "__main__":
    sys.exit(main())
