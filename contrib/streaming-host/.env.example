# Streaming-Host — Konfiguration / configuration
# cp .env.example .env  und ausfüllen. NICHTS hiervon gehört ins Repo.
# Copy to .env and fill in. None of this belongs in version control.

# ---------------------------------------------------------------- Grundlegendes
# Benutzer, dem die Dateien gehören sollen (id -u / id -g).
PUID=1000
PGID=1000
TZ=Etc/UTC
TITLE=Romseerr Streaming

# Wo die Container ihren Zustand ablegen (Emulatoren, Zertifikat, Einstellungen).
CONFIG_DIR=./data

# Die ROM-Bibliothek, so wie der HOST sie sieht. Wird read-only eingehängt.
# Muss dieselbe Bibliothek sein, die Romseerr befüllt.
ROMS_DIR=/pfad/zu/deiner/rom-bibliothek

# ---------------------------------------------------------------- GPU (Pflicht)
# BEIDE Knoten DERSELBEN Karte. Ohne GPU rendert Mesa auf der CPU (llvmpipe) und
# PS2/GameCube sind unbrauchbar langsam — es "läuft" dabei trotzdem, das ist die
# Tücke. Prüfen mit:  ls -l /dev/dri/   und  ls /sys/class/drm/card*/device/drm/
#
# BOTH nodes of the SAME card. Without a GPU, Mesa falls back to llvmpipe on the
# CPU — it still "works", which is exactly what makes this easy to miss.
DRI_RENDER_NODE=/dev/dri/renderD128

# GPU-Kodierung. OHNE DAS kodiert Selkies in SOFTWARE — gemessen ~1,2 CPU-Kerne je
# Sitzung, waehrend die Video-Engine der Karte brachliegt. Der Grund: Selkies leitet den
# GPU-Index sonst aus dem NAMEN des Knotens ab (renderD129 -> Index 1) und oeffnet die
# n-te Karte, waehrend der Container genau eine hat. Nur abschalten, wenn die Karte
# nachweislich nicht kodieren kann.
# EN: without this Selkies encodes in software (~1.2 CPU cores per session).
SELKIES_AUTO_GPU=true
DRI_CARD_NODE=/dev/dri/card0

# Wenn andere Dienste (z. B. Transkodierung) dieselbe Maschine nutzen: gib dem
# Streaming-Host einen EIGENEN Render-Knoten, sonst konkurrieren sie.
SHM_SIZE=2g

# Fassung von VirtualGL, die `init/10-virtualgl` beim ersten Start holt. Der Wert
# geht direkt in die Download-Adresse des Releases — eine Fassung, die es dort nicht
# gibt, laesst die Installation fehlschlagen, nicht auf etwas anderes zurueckfallen.
# Seit dem DRI3-Nachtrag im README ist VirtualGL fuer die meisten Emulatoren gar nicht
# mehr noetig (Vulkan rendert direkt); der Schalter bleibt fuer die Faelle, die ihn
# brauchen. Nur anfassen, wenn eine bestimmte Fassung gebraucht wird.
# EN: VirtualGL release fetched by init/10-virtualgl; the value goes straight into the
# release download URL, so a non-existent version fails the install rather than falling
# back. Largely unnecessary since the DRI3 note in the README.
VGL_VERSION=3.1.4

# ---------------------------------------------------------------- Ports
# HTTP ist nur zum Hineinschauen. Ton und Gamepad brauchen HTTPS — siehe README.
HTTP_PORT=8900
HTTPS_PORT=8902
AGENT_PORT=8901

# Zweiter Platz (#137) — nur noetig, wenn du `--profile seat2` benutzt.
# Zwei Leute koennen dann gleichzeitig spielen. Alles unter /config bleibt GETEILT:
# Emulatoren, Firmware, Speicherstaende. Spielen beide denselben Emulator, schreiben
# beide Instanzen dieselben Dateien und wer zuletzt beendet, gewinnt.
# EN: second seat, only needed with `--profile seat2`. /config stays shared.
HTTP_PORT_2=8910
HTTPS_PORT_2=8912
AGENT_PORT_2=8911

# Gemeinsames Geheimnis für den Start-Dienst. ERZEUGEN, nicht ausdenken:
#   openssl rand -base64 24
# Der Dienst startet Prozesse und verweigert den Start ohne Token.
STREAM_AGENT_TOKEN=

# Obergrenze für einen Firmware-Upload an den Start-Dienst, in Byte. Standard 512 MiB.
# Gemessen an dem, was hier tatsächlich hochgeht: Das PS-Vita-Font-Paket ist 56,8 MB,
# die Vita-Firmware liegt im dreistelligen MB-Bereich. Wer die Grenze zu klein setzt,
# bekommt einen abgebrochenen Upload statt einer Fehlermeldung, die den Grund nennt.
# EN: upper bound for a firmware upload to the agent, in bytes. Default 512 MiB.
FIRMWARE_MAX_BYTES=536870912

# ---------------------------------------------------------------- Emulatoren
# Leer lassen = nicht installieren. Es wird NICHTS mitgeliefert; die Skripte laden
# von den offiziellen Projektseiten. Prüfe selbst, was in deiner Rechtsordnung
# zulässig ist — insbesondere BIOS-/Firmware-Abbilder gehören dir, nicht uns.
#
# Nothing is bundled; the scripts fetch from official project sources. Check what
# is permitted where you live — BIOS/firmware images in particular are yours to
# provide, from hardware you own.
# STANDARD: NICHTS. Eine frische Installation lädt keinen einzigen Emulator — du
# wählst in Romseerr unter Einstellungen → Verbindungen aus, was auf deine Maschine
# kommt. Diese Schalter sind nur für unbeaufsichtigte Ausrollungen gedacht; wer sie
# einschaltet, holt beim Containerstart automatisch.
#
# DEFAULT: NOTHING. A fresh host downloads no emulator at all; you pick them in
# Romseerr. These switches exist for unattended deployments only.
INSTALL_PCSX2=false           # PlayStation 2
INSTALL_DOLPHIN=false         # GameCube / Wii (Distributionspaket)
# Aktualisieren: bei jedem Containerstart wird die aktuelle Release-URL geholt und
# mit der installierten verglichen. Aus Romseerr heraus auch direkt auslösbar
# (Einstellungen → Verbindungen → „Emulatoren aktualisieren").
EMU_AUTO_UPDATE=true

# DOWNGRADE, zwei Wege:
#   1. Zurück zur vorigen Fassung — ein Klick in Romseerr. Die letzte Generation wird
#      beim Aktualisieren aufgehoben, es braucht kein Netz und keine Suche.
#   2. Feste Version — hier die vollständige URL des gewünschten Release-Assets
#      eintragen. Sie schlägt die Release-Abfrage und bleibt auch über Neustarts.
PCSX2_URL=
FLYCAST_URL=
XEMU_URL=
CEMU_URL=
AZAHAR_URL=
VITA3K_URL=

INSTALL_FLYCAST=false         # Dreamcast
INSTALL_XEMU=false            # Xbox
INSTALL_CEMU=false            # Wii U
INSTALL_AZAHAR=false          # Nintendo 3DS
INSTALL_VITA3K=false          # PlayStation Vita

# PlayStation 3: RPCS3 legt keine Release-Dateien auf GitHub ab, und der offizielle
# Direktlink weist automatisierte Abrufe ab (HTTP 403). Deshalb URL selbst eintragen.
INSTALL_RPCS3=false
RPCS3_URL=

# Switch: standardmäßig aus. Die grossen Emulatoren wurden nach Rechtsstreit
# eingestellt, die verbliebenen Forks haben eine ungeklärte Rechtslage und wechseln
# ihre Bezugsquelle. Wer das will, trägt die URL selbst ein.
INSTALL_SWITCH_EMU=false
# Entweder eine Release-API (dann aktualisiert es sich selbst) …
SWITCH_EMU_API=
SWITCH_EMU_ASSET=
# … oder eine feste URL (kein automatisches Update).
SWITCH_EMU_URL=

# ---------------------------------------------------------------- Zertifikat
# Nur nötig, wenn du den certbot-Beiwagen nutzt:
#   docker compose --profile acme up -d
# Ohne ihn legst du cert.pem/cert.key selbst nach ${CONFIG_DIR}/config/ssl/.
CERT_DOMAIN=stream.beispiel.tld
CERT_EMAIL=du@beispiel.tld

# DNS-Anbieter für die DNS-01-Prüfung. certbot bringt Plugins für viele mit:
# cloudflare, route53, digitalocean, google, rfc2136, ovh, linode, gehirn, …
# Der Name muss zum Image "certbot/dns-<plugin>" passen.
DNS_PLUGIN=cloudflare

# Datei mit den Zugangsdaten des Anbieters, Rechte 600. Format je Plugin, z. B.
# Cloudflare:   dns_cloudflare_api_token = <token>
# DIESE DATEI NIEMALS EINCHECKEN.
DNS_CREDENTIALS_FILE=/pfad/zu/dns-credentials.ini

PROPAGATION_SECONDS=30
RENEW_INTERVAL=43200

# ---------------------------------------------------------------- Image
WEBTOP_TAG=ubuntu-xfce

# --- Bildgroesse und Bildrate des Streams / stream size and framerate -------------
# Ohne diese Werte richtet sich der Stream nach dem Browserfenster; auf grossen
# Bildschirmen kostet das dauerhaft CPU (gemessen: 3828x1902@60 -> selkies 50 %,
# 1920x1080@30 -> 13 %). Es macht den Emulator nicht schneller, es entlastet den Host.
# 1920x1080 reicht fuer Konsolen, die nativ weit darunter liegen.
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_FRAMERATE=30
