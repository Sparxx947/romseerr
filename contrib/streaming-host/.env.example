# Streaming-Host — Konfiguration / configuration
# cp .env.example .env  und ausfüllen. NICHTS hiervon gehört ins Repo.
# Copy to .env and fill in. None of this belongs in version control.

# ---------------------------------------------------------------- Grundlegendes
# Benutzer, dem die Dateien gehören sollen (id -u / id -g).
PUID=1000
PGID=1000
TZ=Etc/UTC
TITLE=Romseerr Streaming

# Wo die Container ihren Zustand ablegen (Emulatoren, Zertifikat, Einstellungen).
CONFIG_DIR=./data

# Die ROM-Bibliothek, so wie der HOST sie sieht. Wird read-only eingehängt.
# Muss dieselbe Bibliothek sein, die Romseerr befüllt.
ROMS_DIR=/pfad/zu/deiner/rom-bibliothek

# ---------------------------------------------------------------- GPU (Pflicht)
# BEIDE Knoten DERSELBEN Karte. Ohne GPU rendert Mesa auf der CPU (llvmpipe) und
# PS2/GameCube sind unbrauchbar langsam — es "läuft" dabei trotzdem, das ist die
# Tücke. Prüfen mit:  ls -l /dev/dri/   und  ls /sys/class/drm/card*/device/drm/
#
# BOTH nodes of the SAME card. Without a GPU, Mesa falls back to llvmpipe on the
# CPU — it still "works", which is exactly what makes this easy to miss.
DRI_RENDER_NODE=/dev/dri/renderD128
DRI_CARD_NODE=/dev/dri/card0

# Wenn andere Dienste (z. B. Transkodierung) dieselbe Maschine nutzen: gib dem
# Streaming-Host einen EIGENEN Render-Knoten, sonst konkurrieren sie.
SHM_SIZE=2g

# ---------------------------------------------------------------- Ports
# HTTP ist nur zum Hineinschauen. Ton und Gamepad brauchen HTTPS — siehe README.
HTTP_PORT=8900
HTTPS_PORT=8902
AGENT_PORT=8901

# Gemeinsames Geheimnis für den Start-Dienst. ERZEUGEN, nicht ausdenken:
#   openssl rand -base64 24
# Der Dienst startet Prozesse und verweigert den Start ohne Token.
STREAM_AGENT_TOKEN=

# ---------------------------------------------------------------- Emulatoren
# Leer lassen = nicht installieren. Es wird NICHTS mitgeliefert; die Skripte laden
# von den offiziellen Projektseiten. Prüfe selbst, was in deiner Rechtsordnung
# zulässig ist — insbesondere BIOS-/Firmware-Abbilder gehören dir, nicht uns.
#
# Nothing is bundled; the scripts fetch from official project sources. Check what
# is permitted where you live — BIOS/firmware images in particular are yours to
# provide, from hardware you own.
INSTALL_PCSX2=true            # PlayStation 2
INSTALL_DOLPHIN=true          # GameCube / Wii (Distributionspaket)
INSTALL_SWITCH_EMU=false      # Switch — Rechtslage der Forks ist ungeklärt
SWITCH_EMU_URL=               # falls doch: vollständige URL zum AppImage

# ---------------------------------------------------------------- Zertifikat
# Nur nötig, wenn du den certbot-Beiwagen nutzt:
#   docker compose --profile acme up -d
# Ohne ihn legst du cert.pem/cert.key selbst nach ${CONFIG_DIR}/config/ssl/.
CERT_DOMAIN=stream.beispiel.tld
CERT_EMAIL=du@beispiel.tld

# DNS-Anbieter für die DNS-01-Prüfung. certbot bringt Plugins für viele mit:
# cloudflare, route53, digitalocean, google, rfc2136, ovh, linode, gehirn, …
# Der Name muss zum Image "certbot/dns-<plugin>" passen.
DNS_PLUGIN=cloudflare

# Datei mit den Zugangsdaten des Anbieters, Rechte 600. Format je Plugin, z. B.
# Cloudflare:   dns_cloudflare_api_token = <token>
# DIESE DATEI NIEMALS EINCHECKEN.
DNS_CREDENTIALS_FILE=/pfad/zu/dns-credentials.ini

PROPAGATION_SECONDS=30
RENEW_INTERVAL=43200

# ---------------------------------------------------------------- Image
WEBTOP_TAG=ubuntu-xfce
