#!/bin/bash
# 3DS-Entschluesselung bereitstellen: pycryptodome und das Entschluesselungswerkzeug.
#
# WARUM ALS INIT-SKRIPT UND NICHT VON HAND (#354): Ein `pip install` in einen laufenden
# Container haelt bis zum naechsten Abbild-Update. Danach waere die Faehigkeit weg — und
# zwar still: Der Start eines verschluesselten Titels scheiterte wieder, ohne dass jemand
# den Zusammenhang zum Update sieht. Alles, was der Host koennen soll, gehoert hierher.
#
# WARUM UEBERHAUPT: Azahar spielt nur entschluesselte Dumps und entschluesselt NICHT selbst
# (azahar-emu/azahar#2207, "closed as not planned"). Von 1.249 gemessenen Abbildern dieser
# Bibliothek waren 1.248 verschluesselt — ohne diesen Schritt ist die Plattform leer.
#
# WARUM DIESES WERKZEUG: NDecrypt — der erste Suchtreffer — lief durch, meldete Erfolg und
# liess die Datei BYTE-IDENTISCH. 3DS-Decrypt (Python + pycryptodome) traegt die vier
# Retail-KeyX FEST im Quelltext und braucht deshalb WEDER `aes_keys.txt` NOCH `boot9.bin`.
# An einem echten Titel dieser Bibliothek nachgemessen (128 MB): 0,07 s, Pruefsumme
# geaendert, `NoCrypto`-Flag von 0x00 auf 0x04. Entschluesselt werden nur Kopf- und
# ExeFS-Bereiche, nicht das ganze Abbild — die Kosten stecken im Kopieren, nicht hier.
#
# ROMs mit DEV-Schluesseln entschluesselt es nicht; dafuer waeren die auskommentierten
# Werte im Skript einzusetzen. In dieser Bibliothek kam kein solcher Fall vor.
#
# An init script rather than a manual pip install: a running-container install lasts until
# the next image update, and its loss is silent. Azahar does not decrypt by itself, and
# 1,248 of 1,249 measured images in this library are encrypted.
set -uo pipefail

WERKZEUG=/config/tools/3ds-decrypt
QUELLE=${DECRYPT_3DS_URL:-https://raw.githubusercontent.com/aszuraz/3DS-Decrypt/main/decrypt_3ds.py}
# Zweites Werkzeug fuer `.cia` (#315). Azahar blockt eine verschluesselte CIA genauso wie
# ein verschluesseltes Abbild — `Blocked unauthorized encrypted CIA installation` — und das
# Gegenstueck liegt im selben Repository.
WERKZEUG_CIA=/config/tools/3ds-decrypt-cia
QUELLE_CIA=${DECRYPT_CIA_URL:-https://raw.githubusercontent.com/aszuraz/3DS-Decrypt/main/decrypt_cia.py}

# KEINE Sperre auf `boot9.bin`: Die erste Fassung dieses Skripts pruefte darauf, weil die
# Beschreibung des Werkzeugs es nahelegte. Der Quelltext sagt etwas anderes — die Schluessel
# stehen fest darin, `boot9.bin` wird nie geoeffnet. Die Sperre pruefte eine Voraussetzung,
# die es nicht gibt, und lag zudem VOR `25-firmware`, das die Datei erst hinlegt: Sie konnte
# auf einem frischen Container nie zutreffen. Azahar selbst braucht die Firmware sehr wohl,
# aber dafuer ist `25-firmware` zustaendig. (#356)
#
# No boot9.bin gate: the tool carries the retail keys in its source and never opens that
# file. The gate tested a precondition that does not exist, and ran before the script that
# places the file.

mkdir -p "$(dirname "$WERKZEUG")"

# pycryptodome: nur installieren, wenn es fehlt. `--break-system-packages` ist noetig, weil
# das Abbild eine verwaltete Umgebung mitbringt; ein venv waere hier eine zweite Python-
# Installation fuer eine einzige Bibliothek.
if ! python3 -c "import Crypto" >/dev/null 2>&1; then
  echo "[3ds] installiere pycryptodome / installing pycryptodome"
  pip install --quiet --no-cache-dir --break-system-packages pycryptodome 2>/dev/null \
    || pip install --quiet --no-cache-dir pycryptodome 2>/dev/null \
    || { echo "[3ds] pycryptodome liess sich nicht installieren / install failed"; exit 0; }
fi

hole() {
  # $1 Zielpfad, $2 Quelle. Erst nach erfolgreichem Download an seinen Platz: ein halb
  # geladenes Skript waere vorhanden und kaputt, und das ist schlechter als abwesend.
  [ -s "$1" ] && return 0
  echo "[3ds] hole $(basename "$1") / fetching $(basename "$1")"
  if ! curl -fsSL --max-time 60 -o "$1.part" "$2"; then
    echo "[3ds] Download fehlgeschlagen: $(basename "$1") / download failed"
    rm -f "$1.part"
    return 1
  fi
  mv "$1.part" "$1"
}

hole "$WERKZEUG" "$QUELLE" || exit 0
# Die CIA-Seite darf fehlen, ohne die Abbild-Seite mitzureissen: Verschluesselte `.3ds`
# sind 1.248 von 1.249 Titeln, `.cia` sind 25. Ein Fehlschlag hier kostet zehn Titel,
# keine Plattform.
hole "$WERKZEUG_CIA" "$QUELLE_CIA" || true

chmod +x "$WERKZEUG" "$WERKZEUG_CIA" 2>/dev/null || true
chown -R "${PUID:-1000}:${PGID:-1000}" /config/tools 2>/dev/null || true

if python3 -c "import Crypto" >/dev/null 2>&1 && [ -s "$WERKZEUG" ]; then
  if [ -s "$WERKZEUG_CIA" ]; then
    echo "[3ds] Entschluesselung bereit, mit CIA / decryption ready, CIA included"
  else
    echo "[3ds] Entschluesselung bereit, OHNE CIA / decryption ready, without CIA"
  fi
else
  echo "[3ds] Entschluesselung NICHT bereit / decryption NOT ready"
fi
