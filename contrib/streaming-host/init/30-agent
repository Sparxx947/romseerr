#!/bin/bash
# Start-Dienst, den Romseerr aufruft. / Launch service Romseerr calls.
#
# Alle Emulatoren laufen über VirtualGL — ohne das rendert Mesa auf der CPU
# (siehe 10-virtualgl). Der Card-Knoten wird dort ermittelt und hier gelesen,
# damit niemand raten muss, welcher es ist.
#
# All emulators run through VirtualGL; the card node is detected in 10-virtualgl.
#
# Das Token wird AUS EINER DATEI gelesen und nicht ins Skript geschrieben:
# ein Geheimnis gehört an genau eine Stelle, sonst laufen die Kopien auseinander.
# The token is read from a file rather than written into this script.
set -u

TOKFILE=/config/agent-token
if [ -n "${STREAM_AGENT_TOKEN:-}" ]; then
  printf '%s' "${STREAM_AGENT_TOKEN}" > "$TOKFILE"
  chmod 600 "$TOKFILE"
fi
if [ ! -s "$TOKFILE" ]; then
  echo "[agent] kein Token gesetzt — Dienst startet NICHT."
  echo "[agent] no token configured — refusing to start. Set STREAM_AGENT_TOKEN in .env"
  exit 0
fi

VGLDEV=$(cat /config/.vgl-device 2>/dev/null)
if [ -n "$VGLDEV" ] && [ -x /opt/VirtualGL/bin/vglrun ]; then
  VGL="/opt/VirtualGL/bin/vglrun -d ${VGLDEV}"
  echo "[agent] GPU über VirtualGL auf ${VGLDEV} / GPU via VirtualGL"
else
  VGL=""
  echo "[agent] WARNUNG: ohne VirtualGL — es wird auf der CPU gerendert"
  echo "[agent] WARNING: no VirtualGL — rendering will be on the CPU"
fi

# --- Gamepad ------------------------------------------------------------------
# Ein Container darf keine Eingabegeraete anlegen. Selkies loest das mit einem
# vorgeladenen Interposer, der das OEFFNEN von /dev/input/js* abfaengt und die Daten
# ueber einen Unix-Socket vom Browser holt.
#
# Die Doku des Projekts nennt DREI Variablen (docs/component.md). Das Abbild setzt
# zwei davon selbst — SELKIES_INTERPOSER und LD_PRELOAD — und laesst die dritte weg.
# Ohne sie hat SDL keinen Hinweis, welches Geraet gemeint ist, und der Emulator sieht
# schlicht kein Pad. Nachgemessen am laufenden Container: SDL_JOYSTICK_DEVICE war
# nicht gesetzt.
#
# Selkies documents three variables; the image sets two and omits SDL_JOYSTICK_DEVICE.
# Verified missing on the running container.
export SDL_JOYSTICK_DEVICE="${SDL_JOYSTICK_DEVICE:-/dev/input/js0}"
# Defensiv: laeuft dieses Skript einmal in einem Zusammenhang OHNE die Vorgabe des
# Abbilds (etwa von Hand nachgestartet), fehlte sonst der Interposer ganz.
INTERPOSER="${SELKIES_INTERPOSER:-/usr/lib/selkies_joystick_interposer.so}"
# `set -u` ist oben gesetzt, und LD_PRELOAD ist NICHT immer da — beim Aufruf von Hand
# (docker exec) fehlt es. Jede Erwaehnung braucht deshalb einen Vorgabewert, sonst
# bricht das Skript ab, bevor es den Dienst startet. Genau so passiert.
# LD_PRELOAD is not always set, and `set -u` turns each bare mention into an abort
# before the service is ever started.
case ":${LD_PRELOAD:-}:" in
  *":$INTERPOSER:"*) ;;                      # schon vorgeladen / already preloaded
  *) [ -f "$INTERPOSER" ] && export LD_PRELOAD="${INTERPOSER}${LD_PRELOAD:+:${LD_PRELOAD}}" ;;
esac
echo "[agent] Gamepad: SDL_JOYSTICK_DEVICE=$SDL_JOYSTICK_DEVICE"
# WICHTIG fuer die Bedienung: Der Browser meldet ein Pad erst, NACHDEM eine Taste
# darauf gedrueckt wurde (so ist die Gamepad-API festgelegt), und viele Emulatoren
# lesen die Geraeteliste nur beim Start. Reihenfolge also: Pad verbinden, Taste
# druecken, DANN starten. Andersherum bleibt es stumm, ohne dass etwas kaputt ist.
# The browser only reports a pad after a button press, and emulators enumerate at
# startup — so connect, press, then launch.

EMU=/config/emulators
STREAM_AGENT_TOKEN="$(cat "$TOKFILE")"; export STREAM_AGENT_TOKEN
export STREAM_AGENT_PORT="${AGENT_PORT:-8901}"
export STREAM_ROMS=/roms
[ -x "$EMU/pcsx2/AppRun" ]     && export EMU_PS2="$VGL $EMU/pcsx2/AppRun -- %s"
[ -x /usr/games/dolphin-emu ]  && export EMU_GC="$VGL /usr/games/dolphin-emu -b -e %s"
[ -x "$EMU/switchemu/AppRun" ] && export EMU_SWITCH="$VGL $EMU/switchemu/AppRun -f -g %s"
[ -x "$EMU/flycast/AppRun" ]   && export EMU_DC="$VGL $EMU/flycast/AppRun %s"
[ -x "$EMU/xemu/AppRun" ]      && export EMU_XBOX="$VGL $EMU/xemu/AppRun -dvd_path %s"
[ -x "$EMU/cemu/AppRun" ]      && export EMU_WIIU="$VGL $EMU/cemu/AppRun -g %s"
[ -x "$EMU/azahar/AppRun" ]    && export EMU_3DS="$VGL $EMU/azahar/AppRun %s"
[ -x "$EMU/vita3k/AppRun" ]    && export EMU_VITA="$VGL $EMU/vita3k/AppRun -r %s"
[ -x "$EMU/rpcs3/AppRun" ]     && export EMU_PS3="$VGL $EMU/rpcs3/AppRun --no-gui %s"

pkill -f stream-agent.py 2>/dev/null || true
# Aus dem eingehaengten Repo starten, nicht aus /config: was laeuft, ist damit
# immer das, was im Repo steht. / Run the mounted file, so running == checked out.
AGENT=/opt/stream-agent.py
[ -f "$AGENT" ] || AGENT=/config/stream-agent.py   # Rueckfall fuer Altbestand
setsid nohup python3 "$AGENT" >> /config/stream-agent.log 2>&1 &
echo "[agent] gestartet auf :${STREAM_AGENT_PORT} / started"
