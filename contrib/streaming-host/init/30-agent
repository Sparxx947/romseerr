#!/bin/bash
# Start-Dienst, den Romseerr aufruft. / Launch service Romseerr calls.
#
# Alle Emulatoren laufen über VirtualGL — ohne das rendert Mesa auf der CPU
# (siehe 10-virtualgl). Der Card-Knoten wird dort ermittelt und hier gelesen,
# damit niemand raten muss, welcher es ist.
#
# All emulators run through VirtualGL; the card node is detected in 10-virtualgl.
#
# Das Token wird AUS EINER DATEI gelesen und nicht ins Skript geschrieben:
# ein Geheimnis gehört an genau eine Stelle, sonst laufen die Kopien auseinander.
# The token is read from a file rather than written into this script.
set -u

TOKFILE=/config/agent-token
if [ -n "${STREAM_AGENT_TOKEN:-}" ]; then
  printf '%s' "${STREAM_AGENT_TOKEN}" > "$TOKFILE"
  chmod 600 "$TOKFILE"
fi
if [ ! -s "$TOKFILE" ]; then
  echo "[agent] kein Token gesetzt — Dienst startet NICHT."
  echo "[agent] no token configured — refusing to start. Set STREAM_AGENT_TOKEN in .env"
  exit 0
fi

VGLDEV=$(cat /config/.vgl-device 2>/dev/null)
if [ -n "$VGLDEV" ] && [ -x /opt/VirtualGL/bin/vglrun ]; then
  VGL="/opt/VirtualGL/bin/vglrun -d ${VGLDEV}"
  echo "[agent] GPU über VirtualGL auf ${VGLDEV} / GPU via VirtualGL"
else
  VGL=""
  echo "[agent] WARNUNG: ohne VirtualGL — es wird auf der CPU gerendert"
  echo "[agent] WARNING: no VirtualGL — rendering will be on the CPU"
fi

# --- Gamepad ------------------------------------------------------------------
# Ein Container darf keine Eingabegeraete anlegen. Selkies loest das mit einem
# vorgeladenen Interposer, der das OEFFNEN von /dev/input/js* abfaengt und die Daten
# ueber einen Unix-Socket vom Browser holt.
#
# Die Doku des Projekts nennt DREI Variablen (docs/component.md). Das Abbild setzt
# zwei davon selbst — SELKIES_INTERPOSER und LD_PRELOAD — und laesst die dritte weg.
# Ohne sie hat SDL keinen Hinweis, welches Geraet gemeint ist, und der Emulator sieht
# schlicht kein Pad. Nachgemessen am laufenden Container: SDL_JOYSTICK_DEVICE war
# nicht gesetzt.
#
# Selkies documents three variables; the image sets two and omits SDL_JOYSTICK_DEVICE.
# Verified missing on the running container.
export SDL_JOYSTICK_DEVICE="${SDL_JOYSTICK_DEVICE:-/dev/input/js0}"

# ---- Anzeige-Unterbau festnageln --------------------------------------------------
# Die Emulatoren laufen heute auf X11, weil es im Container NICHTS ANDERES GIBT:
# WAYLAND_DISPLAY ist nicht gesetzt, ein Wayland-Socket existiert nicht. Das ist eine
# Abwesenheit, keine Entscheidung — und sie traegt nicht weit. Nachgemessen liefert
# jedes Qt-AppImage BEIDE Plugins:
#
#     /config/emulators/dolphin/usr/plugins/platforms/libqwayland.so
#     /config/emulators/dolphin/usr/plugins/platforms/libqxcb.so
#
# Qt waehlt Wayland, sobald WAYLAND_DISPLAY gesetzt ist; SDL entscheidet ueber seine
# eigene Treiberliste ebenso. Sobald das Abbild wechselt oder Xvfb durch ein echtes
# Xorg ersetzt wird (#169), koennte ein Emulator einen Unterbau waehlen, den niemand
# ausgesucht hat — und der Fehler saehe nach kaputtem Emulator aus, nicht nach
# geaenderter Umgebung. Genau deshalb steht die Vorgabe hier und nicht im Kommentar.
#
# Ueberschreibbar: es geht um eine definierte Vorgabe, nicht um eine Sperre.
#
# The emulators run on X11 only because nothing else exists in the container. Every Qt
# AppImage ships libqwayland.so as well, and Qt prefers it once WAYLAND_DISPLAY is set.
# Pin the backend so #169 does not silently change it. Overridable on purpose.
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}"
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-x11}"
export GDK_BACKEND="${GDK_BACKEND:-x11}"
echo "[agent] Anzeige-Unterbau / display backend: QT_QPA_PLATFORM=$QT_QPA_PLATFORM" \
     "SDL_VIDEODRIVER=$SDL_VIDEODRIVER GDK_BACKEND=$GDK_BACKEND DISPLAY=${DISPLAY:-?}"
# Defensiv: laeuft dieses Skript einmal in einem Zusammenhang OHNE die Vorgabe des
# Abbilds (etwa von Hand nachgestartet), fehlte sonst der Interposer ganz.
INTERPOSER="${SELKIES_INTERPOSER:-/usr/lib/selkies_joystick_interposer.so}"
# `set -u` ist oben gesetzt, und LD_PRELOAD ist NICHT immer da: beim Aufruf von Hand
# (`docker exec`) greift die Umgebung von s6 nicht. Jede Erwaehnung braucht deshalb
# einen Vorgabewert, sonst bricht das Skript ab, bevor es den Dienst startet.
#
# UND es genuegt nicht, den Interposer allein nachzusetzen. Das Abbild laedt ZWEI
# Bibliotheken vor: den Interposer UND eine gefaelschte libudev — ueber die findet SDL
# die Geraete ueberhaupt erst. Ein Nachbau von Hand hatte nur die erste, und dann
# steht ein Geraetepfad bereit, den niemand aufzaehlt.
#
# Deshalb wird die maszgebliche Fassung dort gelesen, wo das Abbild sie hinterlegt,
# statt sie hier nachzubauen. Nachbauen hiesse, eine zweite Wahrheit zu pflegen, die
# beim naechsten Abbild-Update falsch ist.
#
# Read the image's own value rather than reconstructing it: it preloads TWO libraries,
# the interposer and a fake libudev through which SDL enumerates devices at all.
S6_PRELOAD=/run/s6/container_environment/LD_PRELOAD
if [ -z "${LD_PRELOAD:-}" ] && [ -r "$S6_PRELOAD" ]; then
  LD_PRELOAD=$(cat "$S6_PRELOAD"); export LD_PRELOAD
fi
case ":${LD_PRELOAD:-}:" in
  *":$INTERPOSER:"*) ;;                      # schon vorgeladen / already preloaded
  *) [ -f "$INTERPOSER" ] && export LD_PRELOAD="${INTERPOSER}${LD_PRELOAD:+:${LD_PRELOAD}}" ;;
esac
echo "[agent] LD_PRELOAD=${LD_PRELOAD:-—}"
echo "[agent] Gamepad: SDL_JOYSTICK_DEVICE=$SDL_JOYSTICK_DEVICE"
# WICHTIG fuer die Bedienung: Der Browser meldet ein Pad erst, NACHDEM eine Taste
# darauf gedrueckt wurde (so ist die Gamepad-API festgelegt), und viele Emulatoren
# lesen die Geraeteliste nur beim Start. Reihenfolge also: Pad verbinden, Taste
# druecken, DANN starten. Andersherum bleibt es stumm, ohne dass etwas kaputt ist.
# The browser only reports a pad after a button press, and emulators enumerate at
# startup — so connect, press, then launch.

EMU=/config/emulators
STREAM_AGENT_TOKEN="$(cat "$TOKFILE")"; export STREAM_AGENT_TOKEN
export STREAM_AGENT_PORT="${AGENT_PORT:-8901}"
export STREAM_ROMS=/roms
# ENTPACKTE APPIMAGES BRAUCHEN IHRE EIGENEN VARIABLEN. (#440)
#
# `linuxdeploy` erzeugt bei manchen Emulatoren ein `AppRun.wrapped`, das das Programm NUR
# startet, wenn `$APPIMAGE` gesetzt ist:
#
#     if [ "${APPIMAGE}" != "" ]; then "${APPDIR}/usr/bin/Vita3K" $@ ; fi
#
# Die Variable setzt die AppImage-Laufzeit, wenn das Abbild sich selbst startet. Wir starten
# aber den ENTPACKTEN Baum — dann ist sie leer, der Zweig wird uebersprungen, und der Prozess
# endet mit **Exit 0 und ohne jede Ausgabe**. Genau das war das „oeffnet kein Fenster" aus
# #136, und es sah nach einem defekten Emulator aus statt nach einer Verpackungsluecke.
#
# Betroffen sind vita3k, cemu und rpcs3. Gesetzt wird es fuer ALLE, nicht nur fuer die drei:
# `APPDIR` auf den entpackten Baum zu zeigen ist das, was die Laufzeit ohnehin taete — es ist
# also richtig und nicht bloss harmlos. Vier Sonderfaelle waeren die Sorte Wissen, die beim
# naechsten neuen Emulator fehlt.
#
# EN: some extracted AppImages only run when $APPIMAGE is set — otherwise they exit 0 with no
# output at all. Set for every emulator rather than for the three known ones.
apprun() {   # <ordner> -> Kommando-Praefix bis einschliesslich AppRun
  printf 'env APPDIR=%s/%s APPIMAGE=%s/%s/AppRun %s %s/%s/AppRun' \
         "$EMU" "$1" "$EMU" "$1" "$VGL" "$EMU" "$1"
}

[ -x "$EMU/pcsx2/AppRun" ]     && export EMU_PS2="$(apprun pcsx2) -- %s"
# NUR die AppImage. Der frueher hier stehende Rueckfall auf /usr/games/dolphin-emu
# ist bewusst entfernt: das apt-Paket startet, legt seine Konfiguration an und oeffnet
# NIE ein Fenster (#165). Ein Rueckfall auf etwas, das nachweislich nicht funktioniert,
# ist schlechter als keiner — er macht aus einem klaren "nicht installiert" ein
# stummes "Knopf da, nichts passiert".
# Only the AppImage: falling back to something that provably does not work turns a
# clear "not installed" into a silent "button there, nothing happens".
[ -x "$EMU/dolphin/AppRun" ]   && export EMU_GC="$(apprun dolphin) -b -e %s"
[ -x "$EMU/switchemu/AppRun" ] && export EMU_SWITCH="$(apprun switchemu) -f -g %s"
[ -x "$EMU/flycast/AppRun" ]   && export EMU_DC="$(apprun flycast) %s"
# `-batch` startet den Titel ohne Umweg ueber die Bibliotheksoberflaeche und beendet
# DuckStation beim Herunterfahren des Spiels — sonst bliebe ein Fenster stehen, das aus
# der Ferne niemand schliesst. / EN: -batch boots straight into the title and exits with
# it, instead of leaving a window nobody can close remotely.
[ -x "$EMU/duckstation/AppRun" ] && export EMU_PSX="$(apprun duckstation) -batch -fullscreen %s"
[ -x "$EMU/xemu/AppRun" ]      && export EMU_XBOX="$(apprun xemu) -dvd_path %s"
[ -x "$EMU/cemu/AppRun" ]      && export EMU_WIIU="$(apprun cemu) -g %s"
[ -x "$EMU/azahar/AppRun" ]    && export EMU_3DS="$(apprun azahar) %s"
[ -x "$EMU/vita3k/AppRun" ]    && export EMU_VITA="$(apprun vita3k) -r %s"
[ -x "$EMU/rpcs3/AppRun" ]     && export EMU_PS3="$(apprun rpcs3) --no-gui %s"

pkill -f stream-agent.py 2>/dev/null || true
# Aus dem eingehaengten Repo starten, nicht aus /config: was laeuft, ist damit
# immer das, was im Repo steht. / Run the mounted file, so running == checked out.
AGENT=/opt/stream-agent.py
[ -f "$AGENT" ] || AGENT=/config/stream-agent.py   # Rueckfall fuer Altbestand

# ALTBESTAND HEILEN, bevor der Dienst startet. Solange er als root lief, gehoerten die
# Konfigurationen der Emulatoren root — und ein im Desktop gestarteter Emulator (der
# als `abc` laeuft) konnte sie weder lesen noch schreiben. Gefunden wurden so:
# Dolphins Verzeichnis (nicht beschreibbar), PCSX2.ini mit Modus 600 (nicht lesbar),
# RPCS3s input_configs. Nur die tatsaechlich root-eigenen Dateien anfassen — ein
# pauschales `chown -R` ueber /config waere langsam und wuerde Fremdes mitnehmen.
# EN: heal what the root-run agent left behind, touching only root-owned files.
for baum in /config/.config /config/.local/share; do
  [ -d "$baum" ] || continue
  find "$baum" -user 0 -exec chown "${PUID:-abc}:${PGID:-users}" {} + 2>/dev/null || true
done

# DEN DIENST MIT ABGESENKTEN RECHTEN STARTEN (#273).
#
# Vorher lief er als root und startete die Emulatoren ebenfalls als root. Beide
# schreiben Konfigurationen — und je nachdem, ob ein Titel ueber Romseerr oder von
# Hand im Desktop gestartet wurde, gehoerte die Datei danach root oder `abc`, und die
# jeweils andere Seite war ausgesperrt. Das Fehlerbild ist ein "defekter Controller"
# oder ein Emulator, der Einstellungen vergisst, OHNE jede Fehlermeldung.
#
# `s6-setuidgid` statt `setpriv`, weil es die ZUSATZGRUPPEN behaelt — nachgemessen:
#   uid=99(abc) gid=100(users) groups=100(users),18(video5zxv),27(sudo),990(docker)
# `video5zxv` ist die Gruppe der GPU-Knoten; ohne sie waere die Beschleunigung weg.
#
# Der Token wird oben aus der Datei gelesen und als Variable weitergereicht, der
# Dienst braucht dafuer also kein root — die Datei bleibt root:600.
# EN: run the service as abc; s6-setuidgid keeps the supplementary groups, which is
# where GPU access lives. The token is passed in as a variable, so no root needed.
setsid nohup s6-setuidgid abc python3 "$AGENT" >> /config/stream-agent.log 2>&1 &
echo "[agent] gestartet auf :${STREAM_AGENT_PORT} als abc / started as abc"
