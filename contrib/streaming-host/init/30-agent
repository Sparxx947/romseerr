#!/bin/bash
# Start-Dienst, den Romseerr aufruft. / Launch service Romseerr calls.
#
# Alle Emulatoren laufen über VirtualGL — ohne das rendert Mesa auf der CPU
# (siehe 10-virtualgl). Der Card-Knoten wird dort ermittelt und hier gelesen,
# damit niemand raten muss, welcher es ist.
#
# All emulators run through VirtualGL; the card node is detected in 10-virtualgl.
#
# Das Token wird AUS EINER DATEI gelesen und nicht ins Skript geschrieben:
# ein Geheimnis gehört an genau eine Stelle, sonst laufen die Kopien auseinander.
# The token is read from a file rather than written into this script.
set -u

TOKFILE=/config/agent-token
if [ -n "${STREAM_AGENT_TOKEN:-}" ]; then
  printf '%s' "${STREAM_AGENT_TOKEN}" > "$TOKFILE"
  chmod 600 "$TOKFILE"
fi
if [ ! -s "$TOKFILE" ]; then
  echo "[agent] kein Token gesetzt — Dienst startet NICHT."
  echo "[agent] no token configured — refusing to start. Set STREAM_AGENT_TOKEN in .env"
  exit 0
fi

VGLDEV=$(cat /config/.vgl-device 2>/dev/null)
if [ -n "$VGLDEV" ] && [ -x /opt/VirtualGL/bin/vglrun ]; then
  VGL="/opt/VirtualGL/bin/vglrun -d ${VGLDEV}"
  echo "[agent] GPU über VirtualGL auf ${VGLDEV} / GPU via VirtualGL"
else
  VGL=""
  echo "[agent] WARNUNG: ohne VirtualGL — es wird auf der CPU gerendert"
  echo "[agent] WARNING: no VirtualGL — rendering will be on the CPU"
fi

# --- Gamepad ------------------------------------------------------------------
# Ein Container darf keine Eingabegeraete anlegen. Selkies loest das mit einem
# vorgeladenen Interposer, der das OEFFNEN von /dev/input/js* abfaengt und die Daten
# ueber einen Unix-Socket vom Browser holt.
#
# Die Doku des Projekts nennt DREI Variablen (docs/component.md). Das Abbild setzt
# zwei davon selbst — SELKIES_INTERPOSER und LD_PRELOAD — und laesst die dritte weg.
# Ohne sie hat SDL keinen Hinweis, welches Geraet gemeint ist, und der Emulator sieht
# schlicht kein Pad. Nachgemessen am laufenden Container: SDL_JOYSTICK_DEVICE war
# nicht gesetzt.
#
# Selkies documents three variables; the image sets two and omits SDL_JOYSTICK_DEVICE.
# Verified missing on the running container.
export SDL_JOYSTICK_DEVICE="${SDL_JOYSTICK_DEVICE:-/dev/input/js0}"

# ---- Anzeige-Unterbau festnageln --------------------------------------------------
# Die Emulatoren laufen heute auf X11, weil es im Container NICHTS ANDERES GIBT:
# WAYLAND_DISPLAY ist nicht gesetzt, ein Wayland-Socket existiert nicht. Das ist eine
# Abwesenheit, keine Entscheidung — und sie traegt nicht weit. Nachgemessen liefert
# jedes Qt-AppImage BEIDE Plugins:
#
#     /config/emulators/dolphin/usr/plugins/platforms/libqwayland.so
#     /config/emulators/dolphin/usr/plugins/platforms/libqxcb.so
#
# Qt waehlt Wayland, sobald WAYLAND_DISPLAY gesetzt ist; SDL entscheidet ueber seine
# eigene Treiberliste ebenso. Sobald das Abbild wechselt oder Xvfb durch ein echtes
# Xorg ersetzt wird (#169), koennte ein Emulator einen Unterbau waehlen, den niemand
# ausgesucht hat — und der Fehler saehe nach kaputtem Emulator aus, nicht nach
# geaenderter Umgebung. Genau deshalb steht die Vorgabe hier und nicht im Kommentar.
#
# Ueberschreibbar: es geht um eine definierte Vorgabe, nicht um eine Sperre.
#
# The emulators run on X11 only because nothing else exists in the container. Every Qt
# AppImage ships libqwayland.so as well, and Qt prefers it once WAYLAND_DISPLAY is set.
# Pin the backend so #169 does not silently change it. Overridable on purpose.
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}"
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-x11}"
export GDK_BACKEND="${GDK_BACKEND:-x11}"
echo "[agent] Anzeige-Unterbau / display backend: QT_QPA_PLATFORM=$QT_QPA_PLATFORM" \
     "SDL_VIDEODRIVER=$SDL_VIDEODRIVER GDK_BACKEND=$GDK_BACKEND DISPLAY=${DISPLAY:-?}"
# Defensiv: laeuft dieses Skript einmal in einem Zusammenhang OHNE die Vorgabe des
# Abbilds (etwa von Hand nachgestartet), fehlte sonst der Interposer ganz.
INTERPOSER="${SELKIES_INTERPOSER:-/usr/lib/selkies_joystick_interposer.so}"
# `set -u` ist oben gesetzt, und LD_PRELOAD ist NICHT immer da: beim Aufruf von Hand
# (`docker exec`) greift die Umgebung von s6 nicht. Jede Erwaehnung braucht deshalb
# einen Vorgabewert, sonst bricht das Skript ab, bevor es den Dienst startet.
#
# UND es genuegt nicht, den Interposer allein nachzusetzen. Das Abbild laedt ZWEI
# Bibliotheken vor: den Interposer UND eine gefaelschte libudev — ueber die findet SDL
# die Geraete ueberhaupt erst. Ein Nachbau von Hand hatte nur die erste, und dann
# steht ein Geraetepfad bereit, den niemand aufzaehlt.
#
# Deshalb wird die maszgebliche Fassung dort gelesen, wo das Abbild sie hinterlegt,
# statt sie hier nachzubauen. Nachbauen hiesse, eine zweite Wahrheit zu pflegen, die
# beim naechsten Abbild-Update falsch ist.
#
# Read the image's own value rather than reconstructing it: it preloads TWO libraries,
# the interposer and a fake libudev through which SDL enumerates devices at all.
S6_PRELOAD=/run/s6/container_environment/LD_PRELOAD
if [ -z "${LD_PRELOAD:-}" ] && [ -r "$S6_PRELOAD" ]; then
  LD_PRELOAD=$(cat "$S6_PRELOAD"); export LD_PRELOAD
fi
case ":${LD_PRELOAD:-}:" in
  *":$INTERPOSER:"*) ;;                      # schon vorgeladen / already preloaded
  *) [ -f "$INTERPOSER" ] && export LD_PRELOAD="${INTERPOSER}${LD_PRELOAD:+:${LD_PRELOAD}}" ;;
esac
echo "[agent] LD_PRELOAD=${LD_PRELOAD:-—}"
echo "[agent] Gamepad: SDL_JOYSTICK_DEVICE=$SDL_JOYSTICK_DEVICE"
# WICHTIG fuer die Bedienung: Der Browser meldet ein Pad erst, NACHDEM eine Taste
# darauf gedrueckt wurde (so ist die Gamepad-API festgelegt), und viele Emulatoren
# lesen die Geraeteliste nur beim Start. Reihenfolge also: Pad verbinden, Taste
# druecken, DANN starten. Andersherum bleibt es stumm, ohne dass etwas kaputt ist.
# The browser only reports a pad after a button press, and emulators enumerate at
# startup — so connect, press, then launch.

EMU=/config/emulators
STREAM_AGENT_TOKEN="$(cat "$TOKFILE")"; export STREAM_AGENT_TOKEN
export STREAM_AGENT_PORT="${AGENT_PORT:-8901}"
export STREAM_ROMS=/roms
# ENTPACKTE APPIMAGES BRAUCHEN IHRE EIGENEN VARIABLEN. (#440)
#
# `linuxdeploy` erzeugt bei manchen Emulatoren ein `AppRun.wrapped`, das das Programm NUR
# startet, wenn `$APPIMAGE` gesetzt ist:
#
#     if [ "${APPIMAGE}" != "" ]; then "${APPDIR}/usr/bin/Vita3K" $@ ; fi
#
# Die Variable setzt die AppImage-Laufzeit, wenn das Abbild sich selbst startet. Wir starten
# aber den ENTPACKTEN Baum — dann ist sie leer, der Zweig wird uebersprungen, und der Prozess
# endet mit **Exit 0 und ohne jede Ausgabe**. Genau das war das „oeffnet kein Fenster" aus
# #136, und es sah nach einem defekten Emulator aus statt nach einer Verpackungsluecke.
#
# Betroffen sind vita3k, cemu und rpcs3. Gesetzt wird es fuer ALLE, nicht nur fuer die drei:
# `APPDIR` auf den entpackten Baum zu zeigen ist das, was die Laufzeit ohnehin taete — es ist
# also richtig und nicht bloss harmlos. Vier Sonderfaelle waeren die Sorte Wissen, die beim
# naechsten neuen Emulator fehlt.
#
# EN: some extracted AppImages only run when $APPIMAGE is set — otherwise they exit 0 with no
# output at all. Set for every emulator rather than for the three known ones.
apprun() {   # <ordner> -> Kommando-Praefix bis einschliesslich AppRun
  printf 'env APPDIR=%s/%s APPIMAGE=%s/%s/AppRun %s %s/%s/AppRun' \
         "$EMU" "$1" "$EMU" "$1" "$VGL" "$EMU" "$1"
}

# OHNE DEN WRAPPER, DIREKT AUF DIE BINAERDATEI (#489).
#
# Bei den meisten Emulatoren IST `AppRun.wrapped` das Programm und wird `exec`-t — die
# PID bleibt dieselbe. Bei Vita3K ist es ein Shell-Skript, das das Programm als KIND
# startet, ohne `exec`. Nachgemessen:
#
#     head -c2 AppRun.wrapped:   vita3k "#!"      rpcs3 "\177E"   cemu "\177E"
#
#     #!/bin/sh
#     if [ "${APPIMAGE}" != "" ]; then
#         export PATH="$APPDIR/usr/bin:$PATH"
#         "${APPDIR}/usr/bin/Vita3K" $@        <- kein exec, $@ ohne Anfuehrungszeichen
#     fi
#
# Der Agent merkt sich damit die PID der SHELL, und daran haengen drei Folgen:
#
#   /stop wirkt nicht      Der Emulator ueberlebt als Waise (PPid 1); erst `kill -9`
#                          beendet ihn. Der Dienst haelt sich fuer frei, der naechste
#                          Start laeuft gegen einen Emulator, der die GPU noch haelt.
#   Fensterpruefung irrt   `kein sichtbares Fenster zum Prozess` — an der ECHTEN PID
#                          fand dasselbe Werkzeug `Welcome to Vita3K` (#488).
#   Leerzeichen zerfallen  `$@` unquotiert: aus `x PCSF00024` wird `x`. Fuer eine
#                          Titelkennung folgenlos, fuer einen Pfad nicht (#481).
#
# Der Wrapper tut nachweislich nur zweierlei — `PATH` setzen und starten. Beides steht
# hier, also faellt nichts weg.
#
# EN: for most emulators AppRun.wrapped IS the binary and is exec'd; for Vita3K it is a
# shell script that starts the binary as a CHILD without exec, so the agent tracks the
# shell. /stop then fails, the window check looks at the wrong pid, and unquoted "$@"
# splits arguments. The wrapper only sets PATH and runs — both are reproduced here.
apprun_direkt() {   # <ordner> <programm> -> Kommando bis einschliesslich Binaerdatei
  printf 'env APPDIR=%s/%s APPIMAGE=%s/%s/AppRun PATH=%s/%s/usr/bin:%s %s %s/%s/usr/bin/%s' \
         "$EMU" "$1" "$EMU" "$1" "$EMU" "$1" "$PATH" "$VGL" "$EMU" "$1" "$2"
}

# RATSCHE: MELDEN, WENN EIN ANDERER EMULATOR EBENFALLS EINEN SKRIPT-WRAPPER BEKOMMT.
#
# Dass nur Vita3K betroffen ist, ist eine MESSUNG VON HEUTE, keine Eigenschaft von
# AppImages. `linuxdeploy` erzeugt je nach Bauart mal ein ELF, mal ein Skript — ein
# Update kann das jederzeit drehen, und dann ist derselbe Fehler wieder da, nur woanders
# und ohne Hinweis. Die Meldung kostet nichts und macht aus einem stummen Rueckfall eine
# Zeile im Protokoll.
# EN: only Vita3K is affected TODAY; linuxdeploy may emit a script for any emulator after
# an update, and the bug would come back silently elsewhere.
for _e in "$EMU"/*/AppRun.wrapped; do
  [ -f "$_e" ] || continue
  _n=$(basename "$(dirname "$_e")")
  [ "$_n" = "vita3k" ] && continue          # bekannt und behandelt
  if [ "$(head -c 2 "$_e" 2>/dev/null)" = "#!" ]; then
    echo "[agent] HINWEIS: $_n/AppRun.wrapped ist ein Skript, kein Programm — der" \
         "Start-Dienst verfolgt dann die Shell statt des Emulators (#489). /stop und" \
         "die Fensterpruefung greifen dort nicht." >&2
    echo "[agent] NOTE: $_n uses a shell wrapper; the service tracks the shell, not the" \
         "emulator (#489)." >&2
  fi
done
unset _e _n

[ -x "$EMU/pcsx2/AppRun" ]     && EMU_PS2="$(apprun pcsx2) -- %s" && export EMU_PS2
# NUR die AppImage. Der frueher hier stehende Rueckfall auf /usr/games/dolphin-emu
# ist bewusst entfernt: das apt-Paket startet, legt seine Konfiguration an und oeffnet
# NIE ein Fenster (#165). Ein Rueckfall auf etwas, das nachweislich nicht funktioniert,
# ist schlechter als keiner — er macht aus einem klaren "nicht installiert" ein
# stummes "Knopf da, nichts passiert".
# Only the AppImage: falling back to something that provably does not work turns a
# clear "not installed" into a silent "button there, nothing happens".
[ -x "$EMU/dolphin/AppRun" ]   && EMU_GC="$(apprun dolphin) -b -e %s" && export EMU_GC
[ -x "$EMU/switchemu/AppRun" ] && EMU_SWITCH="$(apprun switchemu) -f -g %s" && export EMU_SWITCH
# FLYCAST: Vollbild und Vulkan ausdruecklich setzen. (#304)
#
# NACHGEMESSEN, nicht angenommen. Flycast schreibt seine Konfiguration erst beim Beenden;
# die Datei war hier LEER, der Emulator lief also jedes Mal mit den eingebauten Vorgaben:
#
#     [window] fullscreen = no, 640x480     auf einem 1920x1080-Bildschirm
#
# Mit `window:fullscreen=yes` meldet sein eigenes Protokoll `size 1920 x 1080`, das Fenster
# liegt auf 0,0 und die bemalte Flaeche betraegt 100 % (xwd-Messung, 57.600 Abtastpunkte).
#
# ZUR SYNTAX: `-config SEKTION:schluessel=wert`. Ein falsch geschriebener Schluessel wird
# STILL ignoriert — `-config pvr.rend=4` liest Flycast als Sektion `pvr`, Schluessel `rend`
# und tut nichts. Genau daran waere hier fast die Fehldiagnose „Flycast kann kein Vulkan"
# entstanden. Richtig ist die Sektion `config`.
#
# RENDERER: 0 und 3 sind OpenGL, 4 und 5 Vulkan (5 mit Per-Pixel-Sortierung). Gemessen am
# laufenden Host:
#     config:pvr.rend=4 -> rend/vulkan/vulkan_context.cpp:271
#                          N[RENDERER]: Vulkan API 1.1. Device Intel(R) Arc(tm) A310
# samt `VK_KHR_swapchain`. Auf der Arc ist der Vulkan-Treiber der ausgereiftere Weg.
#
# RUECKWEG: Die beiden `-config`-Angaben entfernen — dann gilt wieder OpenGL im Fenster.
# Beide sind fluechtig, sie landen nicht in der Konfigurationsdatei des Nutzers.
#
# EN: measured, not assumed. Flycast only writes its config on exit and the file was empty,
# so it ran with 640x480 windowed defaults on a 1920x1080 screen. Note the syntax: a
# misspelled `-config` key is silently ignored, which nearly produced the wrong conclusion
# that this build has no Vulkan renderer. Rollback: drop both flags.
[ -x "$EMU/flycast/AppRun" ]   && EMU_DC="$(apprun flycast) -config config:pvr.rend=4 -config window:fullscreen=yes %s" && export EMU_DC
# `-batch` startet den Titel ohne Umweg ueber die Bibliotheksoberflaeche und beendet
# DuckStation beim Herunterfahren des Spiels — sonst bliebe ein Fenster stehen, das aus
# der Ferne niemand schliesst. / EN: -batch boots straight into the title and exits with
# it, instead of leaving a window nobody can close remotely.
[ -x "$EMU/duckstation/AppRun" ] && EMU_PSX="$(apprun duckstation) -batch -fullscreen %s" && export EMU_PSX
# XEMU BRAUCHT EINE BIBLIOTHEK, DIE NICHT AUF DEM SUCHPFAD LIEGT (#525).
#
# `init/22-xemu-vorbereiten` leiht `libusb-1.0.so.0` aus einem anderen Emulator-AppImage
# und legt sie nach `/config/lib`. Nur wusste davon niemand:
#
#     ldconfig -p | grep -c libusb   -> 0
#     /etc/ld.so.conf.d/*.conf       -> kein Eintrag fuer /config
#
# Ohne den Pfad endet xemu SOFORT:
#
#     error while loading shared libraries: libusb-1.0.so.0
#
# Von aussen ist das nicht von „der Emulator kann die Plattform nicht" zu unterscheiden:
# Der Stream geht auf und bleibt leer. Am laufenden Host beidseitig nachgemessen — ohne
# den Pfad der Abbruch, mit ihm ein Fenster „xemu | v0.8.136".
#
# WARUM HIER UND NICHT IN `ld.so.conf`: Ein Eintrag im Systempfad gilt fuer ALLE
# Programme im Container und ueberschreibt im Zweifel Bibliotheken, die ein anderes
# AppImage selbst mitbringt. Der Bedarf ist auf xemu beschraenkt, die Ausnahme also auch.
#
# EN: the init borrows libusb into /config/lib, but nothing put that on the loader's
# path, so xemu exited immediately — indistinguishable from "platform not supported".
# Scoped to xemu rather than added to ld.so.conf, which would affect every process.
[ -x "$EMU/xemu/AppRun" ]      && EMU_XBOX="env LD_LIBRARY_PATH=/config/lib $(apprun xemu) -dvd_path %s" && export EMU_XBOX
[ -x "$EMU/cemu/AppRun" ]      && EMU_WIIU="$(apprun cemu) -g %s" && export EMU_WIIU
[ -x "$EMU/azahar/AppRun" ]    && EMU_3DS="$(apprun azahar) %s" && export EMU_3DS
# VITA3K: `%s` IST HIER KEIN PFAD, SONDERN DIE TITELKENNUNG. (#481)
#
# `-r` ist `--installed-path` und nimmt laut eigener Hilfe eine Kennung aus der Menge der
# INSTALLIERTEN Titel — `TEXT:{PCSF00024}`. Mit dem Pfad endet der Start vor jedem Fenster:
#
#     CLI parsing error: --installed-path: /roms/psvita/Gravity not in {PCSF00024}
#     [E] [main]: Failed to initialise config                            (Exit 4)
#
# Der Agent setzt deshalb bei `psvita` die Kennung aus `sce_sys/param.sfo` ein, nicht den
# Pfad. Wer diese Zeile auf den POSITIONALEN Parameter umstellt (`… %s`), bekaeme etwas
# anderes: der installiert und startet, und die Kennung waere dort falsch. Beides zusammen
# muss geaendert werden oder gar nichts.
# EN: `%s` here is the title id, not a path — the agent substitutes it for psvita.
# VITA3K: die Binaerdatei direkt, nicht ueber AppRun (#489, Begruendung bei apprun_direkt).
# Fehlt sie, wird der Wrapper genommen — aber MIT ANSAGE. Ein stiller Rueckfall auf einen
# Startweg, bei dem `/stop` nachweislich nicht wirkt, ist genau die Sorte Netz, in die man
# faellt ohne es zu merken (#500).
# EN: run the binary directly; fall back to AppRun only with a message, never silently.
if [ -x "$EMU/vita3k/usr/bin/Vita3K" ]; then
  EMU_VITA="$(apprun_direkt vita3k Vita3K) -r %s" && export EMU_VITA
elif [ -x "$EMU/vita3k/AppRun" ]; then
  echo "[agent] HINWEIS: vita3k/usr/bin/Vita3K fehlt — Start ueber AppRun. /stop beendet" \
       "den Emulator dann NICHT und die Fensterpruefung sieht die Shell (#489)." >&2
  echo "[agent] NOTE: falling back to vita3k/AppRun; /stop will not stop the emulator." >&2
  EMU_VITA="$(apprun vita3k) -r %s" && export EMU_VITA
fi
[ -x "$EMU/rpcs3/AppRun" ]     && EMU_PS3="$(apprun rpcs3) --no-gui %s" && export EMU_PS3

pkill -f stream-agent.py 2>/dev/null || true
# Aus dem eingehaengten Repo starten, nicht aus /config: was laeuft, ist damit
# immer das, was im Repo steht. / Run the mounted file, so running == checked out.
AGENT=/opt/stream-agent.py
# KEIN RUECKFALL AUF /config (#500). Hier stand:
#
#     [ -f "$AGENT" ] || AGENT=/config/stream-agent.py   # Rueckfall fuer Altbestand
#
# Am laufenden Host nachgemessen, was dieser Rueckfall gestartet haette:
#
#     /opt/stream-agent.py      75621 Byte   1510 Zeilen   (aus dem Repo eingehaengt)
#     /config/stream-agent.py    6703 Byte    158 Zeilen   (7. August, verwaist)
#
# Die Altfassung kennt weder `psx` noch `psvita`, `ps3` oder `xbox`, verdrahtet
# Emulatorpfade, die es nicht mehr gibt (`/usr/games/dolphin-emu`), und hat nichts von
# der Absicherung: keine Pfadeingrenzung, keine Titelkennung (#481), keinen Umgang mit
# den modalen Fenstern (#490, #494, #496).
#
# EIN RUECKFALL IST NUR DANN EIN NETZ, WENN DAS HINEINFALLEN SICHTBAR IST. Dieser hier
# startet einen alten Prozess, der Anfragen beantwortet und gesund aussieht: Der Stream
# kommt hoch, die Emulatortabelle ist falsch, und nichts im Protokoll sagt warum. Ein
# Container, der NICHT hochkommt, ist in zehn Minuten repariert; einer, der falsch
# hochkommt, kostet einen Tag.
#
# Ausloesen wuerde es nur, wenn die Einhaengung von `stack/stream-agent.py` fehlt — und
# genau dann soll es knallen statt leise zu funktionieren.
#
# EN: no fallback to /config. A fallback is a safety net only when falling into it is
# visible; this one silently started a 158-line agent from August that answers requests
# and looks healthy. Refuse loudly instead.
if [ ! -f "$AGENT" ]; then
  echo "[agent] FEHLT: $AGENT — der Start-Dienst wird NICHT gestartet." >&2
  echo "[agent] Erwartet wird die Einhaengung von 'stack/stream-agent.py' nach" >&2
  echo "[agent] '/opt/stream-agent.py'. Fehlt sie, pruefe die Bind-Mounts des" >&2
  echo "[agent] Containers — frueher wich das hier still auf eine Altfassung aus." >&2
  echo "[agent] MISSING: $AGENT — refusing to start rather than running a stale copy." >&2
  exit 1
fi

# ALTBESTAND HEILEN, bevor der Dienst startet. Solange er als root lief, gehoerten die
# Konfigurationen der Emulatoren root — und ein im Desktop gestarteter Emulator (der
# als `abc` laeuft) konnte sie weder lesen noch schreiben. Gefunden wurden so:
# Dolphins Verzeichnis (nicht beschreibbar), PCSX2.ini mit Modus 600 (nicht lesbar),
# RPCS3s input_configs. Nur die tatsaechlich root-eigenen Dateien anfassen — ein
# pauschales `chown -R` ueber /config waere langsam und wuerde Fremdes mitnehmen.
#
# `/config/.cache` FEHLTE HIER UND HAT CEMU BLOCKIERT (#509). Gemessen am 2026-08-13:
#
#     drwxr-xr-x 2 root root  /config/.cache/Cemu     (angelegt 2026-08-10)
#     3044 Dateien unter /config/.cache gehoerten root
#
# Cemu oeffnete daraufhin einen modalen Dialog — „Cemu can't write to
# /config/.cache/Cemu!" — und kam nie bis zu seiner eigenen Initialisierung: kein
# Protokoll, kein Hauptfenster, und der Dialog reagierte weder auf Return noch auf
# Leertaste, Escape oder einen Klick auf seinen Knopf. Von aussen sah das nach einem
# kaputten Startpfad aus (#502) und war eine Rechtefrage.
#
# Der groesste Teil der 3044 war `mesa_shader_cache`: Der Shader-Zwischenspeicher der
# GPU war nie beschreibbar, also hat JEDER Emulator bei JEDEM Start neu uebersetzt.
# Das faellt niemandem auf — es sieht aus wie „die erste Minute ruckelt eben".
#
# WARUM DIE LISTE AUSDRUECKLICH BLEIBT und kein `chown -R /config` wird:
# `/config/agent-token` gehoert root und MUSS `root:600` bleiben — es ist das Einzige
# zwischen einer Anfrage und einem gestarteten Prozess auf dem Host. Ein pauschaler
# Lauf wuerde es `abc` uebergeben.
#
# EN: heal what the root-run agent left behind, touching only root-owned files.
# `/config/.cache` was missing and is what blocked Cemu (#509): 3044 root-owned files,
# a modal dialog no keystroke would dismiss, and a shader cache that was never
# writable. The list stays explicit rather than becoming `chown -R /config`, because
# `/config/agent-token` must remain root:600.
for baum in /config/.config /config/.local/share /config/.cache; do
  [ -d "$baum" ] || continue
  find "$baum" -user 0 -exec chown "${PUID:-abc}:${PGID:-users}" {} + 2>/dev/null || true
done

# DEN DIENST MIT ABGESENKTEN RECHTEN STARTEN (#273).
#
# Vorher lief er als root und startete die Emulatoren ebenfalls als root. Beide
# schreiben Konfigurationen — und je nachdem, ob ein Titel ueber Romseerr oder von
# Hand im Desktop gestartet wurde, gehoerte die Datei danach root oder `abc`, und die
# jeweils andere Seite war ausgesperrt. Das Fehlerbild ist ein "defekter Controller"
# oder ein Emulator, der Einstellungen vergisst, OHNE jede Fehlermeldung.
#
# `s6-setuidgid` statt `setpriv`, weil es die ZUSATZGRUPPEN behaelt — nachgemessen:
#   uid=99(abc) gid=100(users) groups=100(users),18(video5zxv),27(sudo),990(docker)
# `video5zxv` ist die Gruppe der GPU-Knoten; ohne sie waere die Beschleunigung weg.
#
# Der Token wird oben aus der Datei gelesen und als Variable weitergereicht, der
# Dienst braucht dafuer also kein root — die Datei bleibt root:600.
# EN: run the service as abc; s6-setuidgid keeps the supplementary groups, which is
# where GPU access lives. The token is passed in as a variable, so no root needed.
setsid nohup s6-setuidgid abc python3 "$AGENT" >> /config/stream-agent.log 2>&1 &
echo "[agent] gestartet auf :${STREAM_AGENT_PORT} als abc / started as abc"
