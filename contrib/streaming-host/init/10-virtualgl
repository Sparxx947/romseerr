#!/bin/bash
# VirtualGL — der Wrapper steht im Startbefehl, wirkt aber im Regelbetrieb NICHT.
# VirtualGL — wrapped around the launch command, but bypassed in normal operation.
#
# ZWEI DINGE, DIE OFT VERWECHSELT WERDEN (Stand 2026-08-15):
#
# 1. WAS DER STARTBEFEHL TUT — gemessen:
#      /config/.vgl-device        /dev/dri/card2   gesetzt, der Zweig in 30-agent feuert
#      mit `vglrun` gestartet     azahar, cemu, dolphin, duckstation, flycast,
#                                 pcsx2, rpcs3, switchemu, vita3k   (neun)
#      ohne                       xemu, bewusst (#498)
#
# 2. WAS DER EMULATOR DANN WAEHLT: Vulkan — und Vulkan geht an VirtualGL VORBEI. Es ist
#    die Bruecke fuer OpenGL; wer die Karte selbst findet, braucht sie nicht. Deshalb
#    steht `libvglfaker` auch bei laufender Sitzung nicht im Prozess (#167/#169: Dolphin
#    nach der Umstellung, Video-Thread von ~100 % auf 5,7 % eines Kerns).
#
# FOLGE: Der Wrapper ist da, tut aber nichts, solange Vulkan gewaehlt wird. Er ist ein
# RUECKFALL — Jens' Entscheidung vom 2026-08-15: er bleibt genau dafuer installiert.
# Greifen wuerde er, wenn ein Emulator auf OpenGL zurueckfaellt oder DRI3 verschwindet.
#
# ZWEI MESSFALLEN, beide haben heute zugeschlagen:
#   * `docker exec ... echo $VGLDEV` zeigt IMMER leer. Die Variable steht nicht in der
#     Container-Umgebung, `30-agent` liest die Datei erst beim Emulatorstart. Daraus
#     „VirtualGL ist nicht eingerichtet" zu schliessen, ist falsch — so steht es in #628.
#   * `grep libvglfaker /proc/*/maps` findet nichts, solange kein Emulator laeuft. Die
#     Null beweist dann gar nichts; sie beweist erst etwas WAEHREND einer Sitzung.
#
# OFFEN: ob wirklich alle neun Vulkan waehlen. Belegt ist es fuer Dolphin (#167/#169) und
# fuer xemu (#498, dort mit der Messung der beschnittenen Flaeche). Fuer die uebrigen
# sieben ist es angenommen, nicht gemessen — zu klaeren waehrend einer Sitzung mit
# `grep libvglfaker /proc/<pid>/maps`.
#
# EN: the wrapper is in the launch command for nine emulators, but Vulkan bypasses
# VirtualGL entirely — it is the bridge for OpenGL. So it is installed as a fallback
# (Jens' decision, 2026-08-15) and does nothing while Vulkan is chosen. Two measuring
# traps: VGLDEV is never in the container environment, and libvglfaker cannot appear
# while no emulator runs. Whether all nine really choose Vulkan is measured for Dolphin
# and xemu only.
#
# ---------------------------------------------------------------------------------
# WARUM ÜBERHAUPT (historisch — siehe oben):
# Der X-Server im Container ist ein Xvfb ohne DRI3. Ohne DRI3 fällt Mesa auf
# `llvmpipe` zurück — reine Software-Rasterisierung auf der CPU. Das fällt nicht
# auf, weil alles trotzdem läuft; nur eben zehnmal langsamer. Prüfen lässt es sich
# mit `glxinfo -B | grep "OpenGL renderer"`: steht dort llvmpipe, arbeitet die CPU.
# Vulkan verweigert in dem Fall ganz ("No DRI3 support detected - required for
# presentation").
#
# VirtualGL umgeht das: es rendert per EGL direkt auf der Karte und schiebt die
# fertigen Bilder in den X-Server. Kein DRI3 nötig, keine zusätzlichen Rechte.
#
# WHY: the container's Xvfb has no DRI3, so Mesa silently falls back to llvmpipe
# (CPU). Everything still "works" — just far slower. VirtualGL renders via EGL on
# the card and blits the result into X. No DRI3, no extra privileges.
#
# FALLE: VirtualGL will den CARD-Knoten, NICHT den Render-Knoten.
#   vglrun -d /dev/dri/renderD128  ->  "[VGL] ERROR: 245: Invalid EGL device"
#   vglrun -d /dev/dri/card0       ->  funktioniert
# Welcher Knoten es ist, verrät `/opt/VirtualGL/bin/eglinfo -e`:
#   "EGL device ID: egl0 ..., DRI device path: /dev/dri/cardN"
#
# PITFALL: VirtualGL wants the CARD node, not the render node. Check with
# `eglinfo -e`, which prints the DRI device path it expects.
set -u

VGL_VERSION="${VGL_VERSION:-3.1.4}"
VGL_DEB="virtualgl_${VGL_VERSION}_amd64.deb"

if [ ! -x /opt/VirtualGL/bin/vglrun ]; then
  echo "[virtualgl] installiere VirtualGL ${VGL_VERSION} / installing"
  if curl -fsSL --max-time 300 -o /tmp/vgl.deb \
      "https://github.com/VirtualGL/virtualgl/releases/download/${VGL_VERSION}/${VGL_DEB}"; then
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq /tmp/vgl.deb >/dev/null 2>&1 \
      || dpkg -i /tmp/vgl.deb >/dev/null 2>&1
  else
    echo "[virtualgl] FEHLER: Download fehlgeschlagen / download failed"
  fi
  rm -f /tmp/vgl.deb
fi

# glxinfo/eglinfo mitinstallieren — ohne sie lässt sich später nicht nachsehen,
# ob die GPU wirklich benutzt wird. Genau diese Frage stellt sich immer wieder.
# Keep the diagnostic tools; "is the GPU actually used" is the recurring question.
# Ein FEHLSCHLAG WIRD GEMELDET. Vorher verschwand er in /dev/null — und genau das ist
# passiert: mesa-utils fehlte auf dem laufenden Host, die Frage "wird die GPU benutzt"
# war deshalb nicht zu beantworten, und die Fehlersuche lief zweimal in die falsche
# Richtung (#167). Kein Abbruch: ein fehlendes Diagnosewerkzeug ist kein Grund, den
# Host nicht hochkommen zu lassen.
# Report the failure: it was swallowed before, and the missing tool sent an
# investigation down two wrong paths.
if ! dpkg -s mesa-utils >/dev/null 2>&1; then
  if DEBIAN_FRONTEND=noninteractive apt-get install -y -qq mesa-utils >/dev/null 2>&1; then
    echo "[virtualgl] mesa-utils installiert / installed"
  else
    echo "[virtualgl] WARNUNG: mesa-utils liess sich nicht installieren — ohne glxinfo"
    echo "[virtualgl] ist spaeter nicht pruefbar, ob die GPU wirklich benutzt wird."
  fi
fi

if [ -x /opt/VirtualGL/bin/vglrun ]; then
  echo "[virtualgl] bereit / ready"
  # Den passenden Card-Knoten ermitteln und für die anderen Skripte hinterlegen,
  # damit niemand raten muss.
  NODE=$(/opt/VirtualGL/bin/eglinfo -e 2>/dev/null \
          | sed -n 's/.*DRI device path: \(\/dev\/dri\/[a-z0-9]*\).*/\1/p' | head -1)
  if [ -n "${NODE}" ]; then
    echo "${NODE}" > /config/.vgl-device
    echo "[virtualgl] EGL-Gerät / EGL device: ${NODE}"
  else
    echo "[virtualgl] WARNUNG: kein EGL-Gerät gefunden — läuft die GPU-Durchreichung?"
    echo "[virtualgl] WARNING: no EGL device found — is the GPU passed through?"
  fi
else
  echo "[virtualgl] NICHT installiert — es wird auf der CPU gerendert werden"
  echo "[virtualgl] NOT installed — rendering will happen on the CPU"
fi
