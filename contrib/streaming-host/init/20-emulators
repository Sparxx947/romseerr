#!/bin/bash
# Emulatoren bereitstellen und aktuell halten. / Provide and update the emulators.
#
# Es wird NICHTS mitgeliefert. Dieses Skript lädt auf Wunsch von den offiziellen
# Projektquellen — welche Emulatoren zulässig sind und welche BIOS-/Firmware-Dateien
# du besitzt, entscheidest du. Jeder einzelne ist über .env abschaltbar.
#
# Nothing is bundled. This fetches from official project sources if you ask it to.
# Which emulators are lawful for you, and which BIOS/firmware you own, is your call.
#
# AKTUALISIEREN: Läuft bei jedem Containerstart. Mit EMU_AUTO_UPDATE=true wird die
# aktuelle Release-URL geholt und mit der zuletzt installierten verglichen —
# unterscheiden sie sich, wird ersetzt. Ein Neustart des Containers ist damit der
# Aktualisierungslauf; Romseerr kann ihn über den Start-Dienst auch direkt auslösen.
# Bei false wird nur installiert, was fehlt.
#
# UPDATING: runs on every container start. With EMU_AUTO_UPDATE=true the current
# release URL is compared to the installed one and replaced when it differs, so a
# container restart is the update run. Romseerr can trigger it via the launch service.
#
# FALLE: AppImages brauchen FUSE, das ein Container nicht hat. Der naheliegende
# "Fix" wäre `--cap-add SYS_ADMIN` + /dev/fuse — dafür ist ein Spielestarter aber
# kein ausreichender Grund. Deshalb werden AppImages ENTPACKT (--appimage-extract)
# und daraus AppRun gestartet. Läuft ohne jedes Zusatzrecht.
#
# PITFALL: AppImages need FUSE, containers have none. The obvious fix is
# `--cap-add SYS_ADMIN`, far too much for a game launcher. We extract instead.
set -u
EMU=/config/emulators
mkdir -p "$EMU"
AUTO_UPDATE="${EMU_AUTO_UPDATE:-true}"

# Aktuelle Asset-URL aus einer Release-API holen. Funktioniert mit GitHub UND mit
# Forgejo/Gitea — beide liefern `assets[].browser_download_url`. Deshalb steht in der
# Konfiguration eine API-URL und kein fest verdrahteter Anbieter: Projekte ziehen um.
# Works with GitHub and Forgejo/Gitea alike; both expose browser_download_url.
release_asset() {  # release_asset <api-url> <regex>
  curl -fsSL --max-time 60 "$1" 2>/dev/null \
    | grep -o '"browser_download_url": *"[^"]*"' | cut -d'"' -f4 \
    | grep -E "$2" | head -1
}

# ENTPACKTE APPIMAGES BRAUCHEN IHRE VARIABLEN — auch im Desktop-Eintrag. (#482)
#
# `linuxdeploy` erzeugt ein `AppRun.wrapped`, das das Programm NUR startet, wenn `$APPIMAGE`
# gesetzt ist. Die Variable setzt die AppImage-Laufzeit, wenn das Abbild sich selbst
# startet. Wir starten den ENTPACKTEN Baum — dann ist sie leer, der Zweig wird
# uebersprungen, und der Prozess endet mit **Exit 0 und ohne jede Ausgabe**.
#
# Der Agent hat dafuer seit #440 seinen `apprun`-Helfer. Der Desktop-Generator hatte ihn
# nicht, und deshalb war JEDER der elf Eintraege tot: Ein Klick tat buchstaeblich nichts,
# ohne dass irgendwo ein Fehler erschien. Aufgefallen erst, als die Vita-Firmware von Hand
# eingespielt werden musste — und der Desktop der einzige Weg dorthin ist.
#
# EN: an extracted AppImage only runs when $APPIMAGE is set; without it the wrapper exits 0
# in silence. The agent has had a helper for this since #440; the desktop generator did not,
# so all eleven launchers were dead.
apprun_befehl() {   # apprun_befehl <ordner> -> Startbefehl mit gesetzten Variablen
  printf 'env APPDIR=%s/%s APPIMAGE=%s/%s/AppRun %s/%s/AppRun' \
         "$EMU" "$1" "$EMU" "$1" "$EMU" "$1"
}

desktop() {  # desktop <name> <system> <befehl>
  mkdir -p /config/.local/share/applications
  cat > "/config/.local/share/applications/$1.desktop" <<DESK
[Desktop Entry]
Type=Application
Name=$1 ($2)
Exec=$3
Icon=applications-games
Categories=Game;
Terminal=false
DESK
}

# Kern: herunterladen, entpacken, Quelle merken. Die zuletzt installierte URL steht in
# <ordner>.url — sie enthält bei praktisch allen Projekten die Versionsnummer und ist
# damit der einfachste verlässliche Vergleich. Ein Prüfsummen-Abgleich wäre genauer,
# würde aber bei jedem Lauf die ganze Datei ziehen.
# Wie viele vorige Fassungen aufgehoben werden. Drei ist die Vorgabe aus #338; jede
# kostet den vollen Platz des Emulators (AppImages hier: 80-400 MB), deshalb einstellbar.
# EMU_GENERATIONEN=0 schaltet das Aufheben ganz ab.
GENERATIONEN=${EMU_GENERATIONEN:-3}

generationen_schieben() {  # <ordner>  — aktuelle Fassung nach .alt1, Rest weiterruecken
  local dir="$1" i
  # `${dir:?}` statt `$dir`: Waere die Variable je leer, loeschte `rm -rf "$EMU/$dir"`
  # das GESAMTE Emulator-Verzeichnis — alle Emulatoren, alle aufgehobenen Fassungen, in
  # einem Zug. Mit `:?` bricht die Shell stattdessen ab. Die Variable kann hier nicht leer
  # sein, aber genau solche Annahmen halten nicht ewig, und der Preis fuer den Irrtum ist
  # der ganze Bestand. (ShellCheck SC2115)
  # Were dir ever empty, this would delete the entire emulator directory in one go.
  [ -n "${dir:-}" ] || { echo "[emulators] generationen_schieben ohne Ordner"; return 1; }
  [ "$GENERATIONEN" -ge 1 ] 2>/dev/null || { rm -rf "${EMU:?}/${dir:?}"; return 0; }

  # Altbestand aus der Zeit mit nur einer Generation uebernehmen, sonst laege eine
  # brauchbare Fassung unerreichbar daneben. / Migrate the single-generation layout.
  [ -d "$EMU/$dir.alt" ] && [ ! -d "$EMU/$dir.alt1" ] && mv "$EMU/$dir.alt" "$EMU/$dir.alt1"
  [ -f "$EMU/$dir.url.alt" ] && [ ! -f "$EMU/$dir.url.alt1" ] && mv "$EMU/$dir.url.alt" "$EMU/$dir.url.alt1"

  rm -rf "$EMU/$dir.alt$GENERATIONEN"
  rm -f  "$EMU/$dir.url.alt$GENERATIONEN"
  i=$((GENERATIONEN - 1))
  while [ "$i" -ge 1 ]; do
    [ -d "$EMU/$dir.alt$i" ] && mv "$EMU/$dir.alt$i" "$EMU/$dir.alt$((i+1))"
    [ -f "$EMU/$dir.url.alt$i" ] && mv "$EMU/$dir.url.alt$i" "$EMU/$dir.url.alt$((i+1))"
    i=$((i - 1))
  done
  if [ -d "$EMU/$dir" ]; then
    mv "$EMU/$dir" "$EMU/$dir.alt1"
    # Die Marke MUSS mitwandern. Sie ist es, wogegen die automatische Aktualisierung
    # vergleicht — eine zurueckgeholte Fassung ohne ihre Marke wuerde beim naechsten Lauf
    # sofort wieder „aktualisiert", also auf die kaputte Fassung gehoben.
    # The .url marker must travel with its build: the auto-update compares against it.
    [ -f "$EMU/$dir.url" ] && mv "$EMU/$dir.url" "$EMU/$dir.url.alt1"
  fi
}

generationen_zaehlen() {  # <ordner> -> Anzahl aufgehobener Fassungen
  local dir="$1" i=1 n=0
  while [ "$i" -le "${GENERATIONEN:-3}" ]; do
    [ -x "$EMU/$dir.alt$i/AppRun" ] && n=$((n + 1))
    i=$((i + 1))
  done
  echo "$n"
}

install_appimage() {  # install_appimage <name> <ordner> <system> <url>
  local name="$1" dir="$2" sys="$3" url="$4"
  local marker="$EMU/$dir.url" have=""
  [ -f "$marker" ] && have=$(cat "$marker" 2>/dev/null)

  if [ -z "$url" ]; then
    echo "[emulators] $name: keine Quelle ermittelt / no source resolved"
    return 1
  fi

  if [ -x "$EMU/$dir/AppRun" ]; then
    if [ "$AUTO_UPDATE" != "true" ] || [ "$have" = "$url" ]; then
      desktop "$name" "$sys" "$(apprun_befehl "$dir")"
      return 0
    fi
    echo "[emulators] $name: neue Fassung gefunden / newer build found"
  fi

  echo "[emulators] $name: hole / fetching $(basename "$url")"
  if ! curl -fsSL --max-time 900 -o "$EMU/$name.AppImage.part" "$url"; then
    # Ein fehlgeschlagener Download darf die laufende Fassung NICHT beschaedigen.
    # A failed download must never damage the working build.
    echo "[emulators] $name: Download fehlgeschlagen — behalte die vorhandene Fassung"
    echo "[emulators] $name: download failed — keeping the existing build"
    rm -f "$EMU/$name.AppImage.part"
    return 1
  fi
  mv "$EMU/$name.AppImage.part" "$EMU/$name.AppImage"
  chmod +x "$EMU/$name.AppImage"

  # Erst daneben entpacken und nur bei Erfolg tauschen — aus demselben Grund.
  #
  # ACHTUNG, NICHT VEREINFACHEN: `squashfs-root` ist bei modernen AppImages KEIN
  # Verzeichnis. Die uruntime-Laufzeit (pkgforge-Dolphin, RPCS3) entpackt nach
  # `AppDir/` und legt `squashfs-root -> ./AppDir` nur zur Vertraeglichkeit daneben.
  # Ein blosses `mv squashfs-root "$dir.neu"` verschiebt dann DEN SYMLINK, und
  # dieser Ordner zeigt fortan auf ein GETEILTES `AppDir`. Zwei so installierte
  # Emulatoren sind danach dasselbe Programm — der zuletzt entpackte gewinnt, ohne
  # eine einzige Fehlermeldung. Nachgemessen: `dolphin` und `rpcs3` zeigten beide
  # auf `./AppDir`, dessen `AppRun.wrapped` auf `usr/bin/rpcs3` verwies. Ein
  # GameCube-Titel haette RPCS3 gestartet.
  #
  # Deshalb wird aufgeloest, was `squashfs-root` wirklich ist, und DAS verschoben.
  # `AppDir` wird vorher mitentfernt, sonst mischen sich zwei Entpackungen in
  # einem Ordner — auch das war zu sehen, mit zwei .desktop-Dateien nebeneinander.
  #
  # Do not simplify: with uruntime AppImages `squashfs-root` is a symlink to
  # `AppDir`, so moving it yields a shared directory and two emulators become the
  # same program, silently. Resolve it and move the real target.
  ( cd "$EMU" && rm -rf squashfs-root AppDir "$dir.neu" \
      && "./$name.AppImage" --appimage-extract >/dev/null 2>&1 \
      && ziel=$(readlink -f squashfs-root) && [ -d "$ziel" ] \
      && mv "$ziel" "$dir.neu" \
      && rm -f squashfs-root ) || {
    echo "[emulators] $name: Entpacken fehlgeschlagen / extraction failed"
    rm -rf "$EMU/$dir.neu"; return 1; }
  # Ein Symlink an dieser Stelle waere genau der Fehler von oben — lieber laut
  # abbrechen als still ein geteiltes Verzeichnis einhaengen.
  if [ -L "$EMU/$dir.neu" ]; then
    echo "[emulators] $name: Entpackziel ist ein Symlink — abgebrochen / symlinked target"
    rm -f "$EMU/$dir.neu"; return 1
  fi
  # Vorige Fassungen werden aufgehoben, nicht geloescht: ein Update kann eine Regression
  # bringen, und dann will man ohne Netz und ohne Suchen zurueck.
  #
  # WARUM MEHRERE (#338): Frueher war es genau eine, und `rollback` TAUSCHTE current und
  # alt. Zweimal zurueck landete damit wieder am Anfang — es gab keinen zweiten Schritt.
  # Schlimmer: Wird ein Update auf eine bereits kaputte Fassung gelegt, ueberschreibt es
  # die letzte gute. Genau der wahrscheinliche Fall, denn ein defekter Emulator faellt oft
  # erst beim uebernaechsten Start auf.
  #
  # Es ist ein Ring: .alt1 ist die zuletzt abgeloeste, .alt<N> die aelteste. Beim
  # Installieren rutscht alles eine Stelle weiter, die aelteste faellt heraus.
  #
  # Kept generations form a ring: .alt1 is the most recently replaced build, .alt<N> the
  # oldest. Previously there was one, and rollback swapped rather than stepped, so pressing
  # it twice returned to the start.
  generationen_schieben "$dir"
  # DIE NEUE FASSUNG AN IHREN PLATZ. Ohne diese Zeile war ein Update eine LOESCHUNG:
  # `generationen_schieben` raeumt die bisherige Fassung nach `.alt1`, und der frisch
  # entpackte Baum blieb als `$dir.neu` liegen. Danach gab es `$dir` nicht mehr —
  # `30-agent` setzt seine `EMU_*`-Variable aber nur, wenn `$dir/AppRun` existiert, also
  # verschwand die ganze PLATTFORM aus dem Agenten. Lautlos: kein Fehler, kein Fenster,
  # keine fehlende Datei, nach der jemand gesucht haette.
  #
  # Gemessen am 2026-08-12: `ps2` und `ps3` fehlten seit dem 11.08. 10:22 in
  # `/status`, waehrend 17 PS3-Titel in der Bibliothek lagen. Beide waren an dem Tag
  # aktualisiert worden — und genau das war die Ursache. (#440)
  #
  # EN: without this line an update was a deletion. The previous build moves to .alt1 and
  # the new tree stayed at $dir.neu, so $dir was gone and 30-agent dropped the platform.
  mv "$EMU/$dir.neu" "$EMU/$dir" || {
    echo "[emulators] $name: konnte $dir.neu nicht an seinen Platz schieben / rename failed"
    return 1; }
  printf '%s' "$url" > "$marker"
  desktop "$name" "$sys" "$(apprun_befehl "$dir")"
  echo "[emulators] $name: bereit / ready"
}

from_release() {  # <schalter> <name> <ordner> <system> <api-url> <regex>
  [ "${1:-false}" = "true" ] || return 0
  # Feste Version? <NAME>_URL schlaegt die Release-Abfrage. Damit laesst sich gezielt
  # auf eine aeltere Fassung gehen und dort bleiben — auch ueber Neustarts hinweg,
  # denn die automatische Aktualisierung vergleicht dann gegen genau diese URL.
  # A pinned <NAME>_URL beats the release lookup, so a chosen older build sticks.
  local pin
  eval "pin=\${$(echo "$2" | tr '[:lower:]-' '[:upper:]_')_URL:-}"
  if [ -n "$pin" ]; then
    echo "[emulators] $2: feste Version gesetzt / pinned"
    install_appimage "$2" "$3" "$4" "$pin"
    return
  fi
  install_appimage "$2" "$3" "$4" "$(release_asset "$5" "$6")"
}

# Zurueck zur vorigen Fassung. Wird vom Start-Dienst aufgerufen (Romseerr-Knopf).
rollback() {  # rollback <ordner>  — EINEN Schritt zurueck, wiederholbar
  local dir="$1" i
  [ -n "${dir:-}" ] || { echo "[emulators] rollback ohne Ordner / no directory given"; return 1; }

  # Altbestand mit nur einer Generation uebernehmen (#338).
  [ -d "$EMU/$dir.alt" ] && [ ! -d "$EMU/$dir.alt1" ] && mv "$EMU/$dir.alt" "$EMU/$dir.alt1"
  [ -f "$EMU/$dir.url.alt" ] && [ ! -f "$EMU/$dir.url.alt1" ] && mv "$EMU/$dir.url.alt" "$EMU/$dir.url.alt1"

  [ -x "$EMU/$dir.alt1/AppRun" ] || {
    echo "[emulators] $dir: keine vorige Fassung / none kept"; return 1; }

  # WARUM DIE AKTUELLE FASSUNG WEGGEWORFEN WIRD: Wer zurueckgeht, tut das, WEIL die
  # aktuelle kaputt ist. Sie aufzuheben hiesse, sie an Position 1 zu legen — und der
  # naechste Rueckschritt landete wieder bei ihr. Genau dieses Hin und Her war der
  # Fehler der alten Fassung. Nach vorne fuehrt statt dessen ein Update.
  # The current build is discarded: you roll back because it is broken, and keeping it at
  # position 1 is what made the previous implementation toggle instead of step back.
  rm -rf "${EMU:?}/${dir:?}"
  rm -f  "$EMU/$dir.url"
  mv "$EMU/$dir.alt1" "$EMU/$dir"
  [ -f "$EMU/$dir.url.alt1" ] && mv "$EMU/$dir.url.alt1" "$EMU/$dir.url"

  # Der Rest rueckt nach, damit ein weiterer Rueckschritt die naechstaeltere findet.
  i=2
  while [ "$i" -le "${GENERATIONEN:-3}" ]; do
    [ -d "$EMU/$dir.alt$i" ] && mv "$EMU/$dir.alt$i" "$EMU/$dir.alt$((i-1))"
    [ -f "$EMU/$dir.url.alt$i" ] && mv "$EMU/$dir.url.alt$i" "$EMU/$dir.url.alt$((i-1))"
    i=$((i + 1))
  done
  echo "[emulators] $dir: eine Fassung zurueck, $(generationen_zaehlen "$dir") weitere vorhanden"
  echo "[emulators] $dir: stepped back one build, $(generationen_zaehlen "$dir") more available"
}

# Aufruf als "20-emulators --rollback <ordner>" -> nur zuruecksetzen, nichts holen.
if [ "${1:-}" = "--rollback" ] && [ -n "${2:-}" ]; then
  rollback "$2"; exit $?
fi

from_url() {  # <schalter> <name> <ordner> <system> <url>
  [ "${1:-false}" = "true" ] || return 0
  [ -n "${5:-}" ] || { echo "[emulators] $2: keine URL gesetzt / no URL configured"; return 0; }
  install_appimage "$2" "$3" "$4" "$5"
}

GH="https://api.github.com/repos"

# ---------------------------------------------------------------- Katalog
# Eine Zeile je Emulator: name|ordner|system|art|quelle|muster
#
#   art = release  -> quelle ist eine Release-API (GitHub oder Forgejo/Gitea),
#                     muster waehlt daraus das passende Asset
#   art = url      -> quelle ist der NAME einer Umgebungsvariablen mit der URL
#                     (fuer Projekte ohne brauchbare Release-API)
#   art = apt      -> Distributionspaket, quelle ist der Paketname
#
# Diese Tabelle ist die einzige Stelle, an der ein Emulator eingetragen wird. Aus ihr
# ergeben sich der Katalog fuer Romseerr, die Einzelinstallation und der normale Lauf —
# drei Wege, eine Wahrheit. Ein Eintrag mehr heisst: hier eine Zeile.
#
# One line per emulator; the catalogue, single installs and the normal run all derive
# from this table, so there is only one place to add an emulator.
KATALOG=(
  "PCSX2|pcsx2|PS2|release|$GH/PCSX2/pcsx2/releases|linux-appimage-x64-Qt\.AppImage$"
  # Dolphin als AppImage, NICHT als Distributionspaket. Gemessen im Container: das
  # apt-Paket startet, legt alle Konfigurationsdateien an — und oeffnet NIE ein
  # Fenster. Weder mit noch ohne VirtualGL, mit erzwungenem `-platform xcb`, ohne
  # Argumente und mit oder ohne den Selkies-Interposer. Im X-Baum steht nur Qts
  # internes 3x3-Fenster "Qt Selection Owner for dolphin-emu". Die AppImage oeffnet
  # an derselben Stelle "Dolphin 2606". Es war das einzige apt-Paket im Katalog; alle
  # AppImages funktionieren, weil sie ihr eigenes Qt mitbringen. (#165)
  #
  # QUELLE IST INOFFIZIELL — bewusst so entschieden. Dolphin liefert fuer Linux
  # ausschliesslich Flatpak, und Flatpak scheidet hier aus: es braucht bubblewrap, und
  # das kann im unprivilegierten Container keinen Namensraum anlegen
  # ("Operation not permitted"). Eine Sandbox wuerde ausserdem LD_PRELOAD nicht nach
  # innen reichen — daran haengt der Gamepad-Interposer.
  # Unofficial source on purpose: Dolphin ships only Flatpak for Linux, and bubblewrap
  # cannot create a namespace in an unprivileged container.
  "Dolphin|dolphin|GameCube/Wii|release|$GH/pkgforge-dev/Dolphin-emu-AppImage/releases/latest|Dolphin_Emulator-.*x86_64\\.AppImage$"
  "Flycast|flycast|Dreamcast|release|$GH/flyinghead/flycast/releases/latest|flycast-x86_64\.AppImage$"
  # DuckStation veroeffentlicht rollend unter dem Tag `latest` (nicht als Versions-Tag);
  # daneben steht ein `preview` als Vorabversion, das hier bewusst NICHT genommen wird.
  # Das Muster endet auf `-x64.AppImage`, damit die daneben liegende SSE2-Fassung
  # (`DuckStation-x64-SSE2.AppImage`) nicht faelschlich trifft — sie ist fuer alte CPUs.
  # EN: rolling `latest` tag, and the anchor keeps the SSE2 build for old CPUs out.
  "DuckStation|duckstation|PS1|release|$GH/stenzek/duckstation/releases/latest|DuckStation-x64\.AppImage$"
  "xemu|xemu|Xbox|release|$GH/xemu-project/xemu/releases/latest|xemu-[0-9.]+-x86_64\.AppImage$"
  "Cemu|cemu|Wii U|release|$GH/cemu-project/Cemu/releases/latest|Cemu-[0-9.]+-x86_64\.AppImage$"
  "Azahar|azahar|3DS|release|$GH/azahar-emu/azahar/releases/latest|azahar\.AppImage$"
  "Vita3K|vita3k|PS Vita|release|$GH/Vita3K/Vita3K/releases/latest|Vita3K-x86_64\.AppImage$"
  # RPCS3: Der offizielle Direktlink auf rpcs3.net weist automatisierte Abrufe mit
  # HTTP 403 ab — deshalb stand hier bisher "URL selbst eintragen". Das Projekt
  # veroeffentlicht seine Linux-Builds aber selbst auf GitHub, in einem eigenen
  # Binaerdepot. Das laesst sich wie jedes andere Release aufloesen, und damit
  # entfaellt der Handgriff.
  # Nachgemessen: genau EIN Asset trifft das Muster.
  # rpcs3.net rejects automated fetches, but the project publishes its Linux builds
  # in its own GitHub binaries repository, which resolves like any other release.
  "RPCS3|rpcs3|PS3|release|$GH/RPCS3/rpcs3-binaries-linux/releases/latest|rpcs3-.*linux64\.AppImage$"
  # Switch: bewusst ohne eingebaute Adresse. Die grossen Emulatoren wurden nach
  # Rechtsstreit eingestellt, die Forks wechseln ihre Bezugsquelle. Entweder
  # SWITCH_EMU_API + SWITCH_EMU_ASSET (aktualisiert sich dann selbst) oder
  # SWITCH_EMU_URL (feste Adresse).
  "SwitchEmu|switchemu|Switch|switch||"
)

feld() { echo "$1" | cut -d"|" -f"$2"; }

# Der frueher hier stehende Sonderfall fuer ein apt-installiertes Dolphin ist weg:
# er meldete "installiert" fuer einen Emulator, der nachweislich kein Fenster oeffnet.
# Lieber als fehlend fuehren als als vorhanden luegen. (#165)
installiert() { [ -x "$EMU/$1/AppRun" ]; }

# Quelle eines Eintrags aufloesen -> URL (oder leer, wenn nicht ermittelbar)
quelle_von() {  # quelle_von <zeile>
  local art quelle muster
  art=$(feld "$1" 4); quelle=$(feld "$1" 5); muster=$(feld "$1" 6)
  case "$art" in
    release) release_asset "$quelle" "$muster" ;;
    url)     eval "echo \${$quelle:-}" ;;
    switch)  if [ -n "${SWITCH_EMU_API:-}" ]; then
               release_asset "${SWITCH_EMU_API}" "${SWITCH_EMU_ASSET:-\.AppImage$}"
             else echo "${SWITCH_EMU_URL:-}"; fi ;;
    apt)     echo "apt:$quelle" ;;
  esac
}

# Einen Eintrag installieren/aktualisieren, unabhaengig vom INSTALL_*-Schalter.
eintrag_installieren() {  # eintrag_installieren <zeile>
  local name dir sys art url
  name=$(feld "$1" 1); dir=$(feld "$1" 2); sys=$(feld "$1" 3); art=$(feld "$1" 4)
  if [ "$art" = apt ]; then
    local paket; paket=$(feld "$1" 5)
    if ! command -v "/usr/games/$paket" >/dev/null 2>&1; then
      echo "[emulators] $name: installiere $paket / installing"
      apt-get update -qq >/dev/null 2>&1
      DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$paket" >/dev/null 2>&1 || true
    elif [ "$AUTO_UPDATE" = "true" ]; then
      apt-get update -qq >/dev/null 2>&1
      DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --only-upgrade "$paket" >/dev/null 2>&1 || true
    fi
    command -v "/usr/games/$paket" >/dev/null 2>&1 && desktop "$name" "$sys" "/usr/games/$paket"
    return 0
  fi
  # Feste Version? <NAME>_URL schlaegt die Release-Abfrage — so bleibt ein bewusst
  # gewaehlter aelterer Stand auch ueber Neustarts erhalten.
  local pin
  eval "pin=\${$(echo "$name" | tr "[:lower:]-" "[:upper:]_")_URL:-}"
  url="${pin:-$(quelle_von "$1")}"
  install_appimage "$name" "$dir" "$sys" "$url"
}

# ---------------------------------------------------------------- Betriebsarten
# --catalog        -> was ist installierbar, was ist installiert (JSON, fuer Romseerr)
# --only <ordner>  -> genau diesen installieren, unabhaengig von INSTALL_*
# --rollback <o>   -> zurueck zur vorigen Fassung
# ohne Argument    -> alles installieren, was per INSTALL_* eingeschaltet ist
#
# Standard ist bewusst: **nichts**. Eine frische Installation laedt gar nichts; der
# Betreiber entscheidet in Romseerr, was auf seine Maschine kommt. Diese Entscheidung
# hat je nach Rechtsordnung Gewicht und wird niemandem stillschweigend abgenommen.
#
# The default is deliberately nothing: a fresh host downloads none of these. Which
# emulators land on a machine is the operator's decision, not ours to make silently.
if [ "${1:-}" = "--catalog" ]; then
  echo "["
  erste=1
  for zeile in "${KATALOG[@]}"; do
    name=$(feld "$zeile" 1); dir=$(feld "$zeile" 2); sys=$(feld "$zeile" 3); art=$(feld "$zeile" 4)
    inst=false; installiert "$dir" && inst=true
    ver=""; [ -f "$EMU/$dir.url" ] && ver=$(basename "$(cat "$EMU/$dir.url")")
    prev=""; [ -f "$EMU/$dir.url.alt1" ] && prev=$(basename "$(cat "$EMU/$dir.url.alt1")")
    [ -z "$prev" ] && [ -f "$EMU/$dir.url.alt" ] && prev=$(basename "$(cat "$EMU/$dir.url.alt")")
    # Wie viele Fassungen liegen zurueck? Frueher ein Ja/Nein, weil es nur eine gab.
    # Die Oberflaeche soll zeigen koennen, wie weit man zurueckkann (#338).
    keep=$(generationen_zaehlen "$dir")
    rb=false; [ "$keep" -gt 0 ] && rb=true
    braucht=false
    [ "$art" = url ] && [ -z "$(quelle_von "$zeile")" ] && braucht=true
    [ "$art" = switch ] && [ -z "$(quelle_von "$zeile")" ] && braucht=true
    [ $erste -eq 0 ] && echo ","
    erste=0
    printf '  {"name":"%s","dir":"%s","system":"%s","installed":%s,"version":"%s","previous":"%s","can_rollback":%s,"kept":%s,"needs_url":%s}' \
      "$name" "$dir" "$sys" "$inst" "$ver" "$prev" "$rb" "$keep" "$braucht"
  done
  echo; echo "]"
  exit 0
fi

if [ "${1:-}" = "--only" ] && [ -n "${2:-}" ]; then
  for zeile in "${KATALOG[@]}"; do
    if [ "$(feld "$zeile" 2)" = "$2" ]; then
      eintrag_installieren "$zeile"
      chown -R "${PUID:-1000}:${PGID:-1000}" /config/emulators /config/.local 2>/dev/null || true
      exit 0
    fi
  done
  echo "[emulators] unbekannt / unknown: $2"; exit 1
fi

# Normaler Lauf: nur was ausdruecklich eingeschaltet ist.
for zeile in "${KATALOG[@]}"; do
  name=$(feld "$zeile" 1)
  schalter="INSTALL_$(echo "$name" | tr "[:lower:]-" "[:upper:]_")"
  [ "$name" = "SwitchEmu" ] && schalter="INSTALL_SWITCH_EMU"
  # Indirekte Expansion statt `eval`: der Schaltername wird aus dem Katalog gebaut,
  # und ein `eval` darauf ist eine Zeile, die man nicht bauen muss. ${!name} liest
  # dieselbe Variable, ohne dass irgendetwas als Code ausgewertet wird.
  # Indirect expansion instead of eval: same lookup, nothing evaluated as code.
  an="${!schalter:-false}"
  # WARUM NICHT NUR DER SCHALTER (#313): Der Schalter sagt „installiere das beim Start".
  # Wer einen Emulator ueber die Oberflaeche installiert hat, hat ihn nicht gesetzt — und
  # genau das sind hier alle. Ein Aktualisierungslauf uebersprang sie deshalb vollstaendig
  # und meldete trotzdem Erfolg: `/update` sagte „gestartet", die Fassung blieb, wie sie war.
  #
  # Die Regel lautet jetzt: einschalten heisst installieren, installiert sein heisst
  # aktualisieren. Beides zusammen ist das, was ein Nutzer unter „aktualisieren" versteht.
  # The switch means "install this at boot". Anything installed through the interface never
  # sets it, so an update run skipped all of them while reporting success.
  if [ "$an" != "true" ]; then
    installiert "$(feld "$zeile" 2)" || continue
  fi
  eintrag_installieren "$zeile"
done

# ---------------------------------------------------------------- BIOS
# Manche Kerne starten ohne BIOS und scheitern dann still. Wir liefern keins. Lege
# eigene Abbilder (aus Hardware, die dir gehoert) in den Ordner des jeweiligen
# Emulators unter /config — z. B. PCSX2: /config/.config/PCSX2/bios/
mkdir -p /config/.config/PCSX2/bios 2>/dev/null || true

chown -R "${PUID:-1000}:${PGID:-1000}" /config/emulators /config/.local 2>/dev/null || true
installierte=""
for d in "$EMU"/*/; do [ -d "$d" ] && installierte="$installierte$(basename "$d") "; done
echo "[emulators] installiert / installed: ${installierte:-keine}"
