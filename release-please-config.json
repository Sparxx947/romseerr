{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "_kommentar": "docs/openapi.yaml traegt die Version ebenfalls und wird von scripts/build_openapi.py erzeugt. Ohne diesen Eintrag hebt release-please nur version.txt an, die Spec bleibt zurueck und der Gleichstandstest scheitert bei jedem Release. / The spec carries the version too; without this it lags and the sync test fails on every release.",
      "extra-files": ["docs/openapi.yaml"]
    }
  },
  "changelog-sections": [
    { "type": "feat",     "section": "Neu / Features" },
    { "type": "fix",      "section": "Behoben / Fixes" },
    { "type": "perf",     "section": "Leistung / Performance" },
    { "type": "docs",     "section": "Dokumentation / Documentation" },
    { "type": "refactor", "section": "Umbau / Refactoring" },
    { "type": "ci",       "section": "Bau & Prüfung / Build & CI", "hidden": true },
    { "type": "chore",    "section": "Sonstiges / Chores",         "hidden": true },
    { "type": "test",     "section": "Tests",                      "hidden": true }
  ]
}
