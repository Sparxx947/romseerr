# Romseerr — Konfiguration. Kopiere diese Datei nach .env und trage deine Werte ein.
# .env wird NICHT eingecheckt (siehe .gitignore).
#
# URLs: im Full-Stack-Compose zeigen sie auf die DIENSTNAMEN (z.B. http://sabnzbd:8080),
# standalone auf deine Hosts (z.B. http://192.168.1.10:8081).

# --- SABnzbd (Usenet) ---
SAB_URL=http://sabnzbd:8080
SAB_APIKEY=
SAB_CAT=roms                       # eigene, isolierte Kategorie (nicht movies/tv!)

# --- Prowlarr (nur lesend für Usenet-Suche) ---
PROWLARR_URL=http://prowlarr:9696
PROWLARR_APIKEY=
PROWLARR_CATS=1000                 # 1000 = Console

# --- IGDB (Cover, Beschreibungen, „beliebt je Konsole") ---
# https://dev.twitch.tv/console -> Anwendung registrieren
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- RomM (optional, Scan nach Import) ---
ROMM_URL=http://romm:8080
ROMM_USER=
ROMM_PASS=

# --- Benachrichtigungen (Fallback; in der Oberfläche überschreibbar) ---
DISCORD_WEBHOOK=

# --- JDownloader (Filehoster-Zweig) ---
# Drei Sichten auf dieselbe Übergabe. JD_DL_BASE ist die Sicht des JD-Containers;
# Romseerrs Sicht darauf (/jd-output/…) wird daraus ABGELEITET — nur das erste
# Pfadsegment wird ersetzt. Wer sie auseinanderlaufen lässt, wartet auf Dateien in
# einem Ordner, den JDownloader nie befüllt. JD_OUT nur setzen, wenn das nicht passt.
# Three views of the same hand-off; Romseerr's view is derived from JD_DL_BASE. (#197)
JD_DL_BASE=/output/romseerr         # Download-Ordner AUS SICHT des JD-Containers
# JD_OUT=/jd-output/romseerr        # nur nötig, wenn die Ableitung nicht passt

# --- Port ---
# Gilt AUSSEN wie INNEN: Der Compose veröffentlicht PORT:PORT, die App lauscht auf PORT.
# Applies outside and inside — compose publishes PORT:PORT, the app listens on PORT.
PORT=8770

# --- Host-Pfade (für docker-compose volumes) ---
# ACHTUNG: Diese Namen dürfen sich nicht mit denen decken, die Romseerr selbst liest —
# `env_file: [.env]` schiebt jeden Eintrag hier in den Container, und dort gewönne der
# Host-Pfad. Deshalb JD_WATCH_HOST (Host) neben JD_WATCH (Romseerrs Sicht), genau wie
# JD_OUTPUT neben JD_OUT. (#377)
# These names must not collide with the ones Romseerr reads itself — `env_file` pushes
# every entry into the container, where the host path would win.
ROMS_LIB=/pfad/zur/romm-library/roms
SAB_COMPLETE=/pfad/zu/sabnzbd/complete/roms
JD_WATCH_HOST=/pfad/zu/jdownloader/folderwatch
JD_OUTPUT=/pfad/zu/downloads

# --- Nur für den Full-Stack-Compose (RomM-Datenbank) ---
ROMM_DB_PASSWORD=
ROMM_DB_ROOT_PASSWORD=
ROMM_AUTH_SECRET_KEY=               # `openssl rand -hex 32`

# RetroAchievements (optional): Web-API-Key fuer Achievement-Angaben auf der Detailseite.
# Alternativ ueber Einstellungen -> Verbindungen setzbar.
# Archive.org: Schlüsselpaar von archive.org/account/s3.php — KEIN Passwort.
# Ohne diese Werte werden zugangsbeschränkte Titel (Sammlung `loggedin`) erkannt und
# vor dem Download abgelehnt, statt mit HTTP 401 zu scheitern.
IA_ACCESS_KEY=
IA_SECRET_KEY=
RETROACHIEVEMENTS_KEY=

# Filehoster-Kataloge (experimentell, #63): Katalog-JSON-Quellen, eine URL je Zeile
# bzw. komma-getrennt. Es wird BEWUSST keine Quelle mitgeliefert — Romseerr liefert den
# Parser, die Quellen bestimmt der Betreiber. Erwartetes Format:
#   {"name": "...", "downloads": [{"title","uris":[...],"uploadDate","fileSize"}]}
# Leer lassen = der Filehoster-Weg bleibt inaktiv. Auch ueber die Oberflaeche setzbar.
CATALOG_URLS=
# Auffrischintervall der Kataloge in Sekunden (Default 21600 = 6 h). Linkfaeule ist hier
# der Normalfall, deshalb ueberhaupt eine TTL.
ROMSEERR_CATALOG_TTL=

# --- Downloads über einen Tunnel / downloads through a tunnel ---
# Nur fuer den EIGENEN Download (Archive.org). Usenet und Filehoster laufen ueber ihre
# eigenen Clients; deren Netzwerk entscheidet dort. Leer = direkt.
# Fail-closed: gesetzt und nicht nutzbar -> der Download scheitert, KEIN Rueckfall.
DL_PROXY=
