# Romseerr — Konfiguration. Kopiere diese Datei nach .env und trage deine Werte ein.
# .env wird NICHT eingecheckt (siehe .gitignore).
#
# URLs: im Full-Stack-Compose zeigen sie auf die DIENSTNAMEN (z.B. http://sabnzbd:8080),
# standalone auf deine Hosts (z.B. http://192.168.1.10:8081).

# --- SABnzbd (Usenet) ---
SAB_URL=http://sabnzbd:8080
SAB_APIKEY=
SAB_CAT=roms                       # eigene, isolierte Kategorie (nicht movies/tv!)

# --- Prowlarr (nur lesend für Usenet-Suche) ---
PROWLARR_URL=http://prowlarr:9696
PROWLARR_APIKEY=
PROWLARR_CATS=1000                 # 1000 = Console

# --- IGDB (Cover, Beschreibungen, „beliebt je Konsole") ---
# https://dev.twitch.tv/console -> Anwendung registrieren
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- RomM (optional, Scan nach Import) ---
ROMM_URL=http://romm:8080
ROMM_USER=
ROMM_PASS=
# Wie lange eine angemeldete RomM-Sitzung wiederverwendet wird (Sekunden).
# Die Anmeldung kostet gemessen rund eine Sekunde und wurde frueher bei jedem
# Nachschlagen erneut bezahlt (#724). 0 wuerde bedeuten: jedes Mal neu.
# EN: how long an authenticated RomM session is reused, in seconds.
ROMM_SESSION_TTL=900

# Kurzes Gedaechtnis je Suchquelle (#726). Dieselbe Suche kurz hintereinander wartet
# nicht zweimal, und eine ausgefallene Quelle liefert ihren letzten bekannten Stand
# statt „keine Treffer". 0 schaltet beides ab.
# EN: short-lived per-source search cache; 0 turns it off.
SEARCH_CACHE_TTL=600
SEARCH_CACHE_MAX=200

# Gedächtnis für archive.org-Metadaten (#731). Gemessen kostet /metadata/<id> feste
# 8,4–10,6 s je Element, unabhängig von der Größe — und der Abruf steht zweimal im
# Weg: einmal für die Detailkarte, einmal beim Download-Start desselben Elements.
# Längere Frist als bei der Suche, weil hier die Dateiliste eines fremden,
# veröffentlichten Elements gemerkt wird und nicht unser eigener Bestand.
# 0 schaltet beides ab, auch den Rückfall auf den letzten bekannten Stand.
# EN: memory for archive.org item metadata; a flat ~9.4 s per lookup, fetched twice
# (detail card and download start). 0 turns it off, fallback included.
ARCHIVE_META_TTL=3600
ARCHIVE_META_MAX=200

# --- Benachrichtigungen (Fallback; in der Oberfläche überschreibbar) ---
DISCORD_WEBHOOK=

# --- JDownloader (Filehoster-Zweig) ---
# Drei Sichten auf dieselbe Übergabe. JD_DL_BASE ist die Sicht des JD-Containers;
# Romseerrs Sicht darauf (/jd-output/…) wird daraus ABGELEITET — nur das erste
# Pfadsegment wird ersetzt. Wer sie auseinanderlaufen lässt, wartet auf Dateien in
# einem Ordner, den JDownloader nie befüllt. JD_OUT nur setzen, wenn das nicht passt.
# Three views of the same hand-off; Romseerr's view is derived from JD_DL_BASE. (#197)
JD_DL_BASE=/output/romseerr         # Download-Ordner AUS SICHT des JD-Containers
# JD_OUT=/jd-output/romseerr        # nur nötig, wenn die Ableitung nicht passt

# --- Port ---
# Gilt AUSSEN wie INNEN: Der Compose veröffentlicht PORT:PORT, die App lauscht auf PORT.
# Applies outside and inside — compose publishes PORT:PORT, the app listens on PORT.
PORT=8770

# --- Host-Pfade (für docker-compose volumes) ---
# ACHTUNG: Diese Namen dürfen sich nicht mit denen decken, die Romseerr selbst liest —
# `env_file: [.env]` schiebt jeden Eintrag hier in den Container, und dort gewönne der
# Host-Pfad. Deshalb JD_WATCH_HOST (Host) neben JD_WATCH (Romseerrs Sicht), genau wie
# JD_OUTPUT neben JD_OUT. (#377)
# These names must not collide with the ones Romseerr reads itself — `env_file` pushes
# every entry into the container, where the host path would win.
ROMS_LIB=/pfad/zur/romm-library/roms
SAB_COMPLETE=/pfad/zu/sabnzbd/complete/roms
JD_WATCH_HOST=/pfad/zu/jdownloader/folderwatch
# Einwurfordner fuer den Massenimport (#396) — Host-Pfad. Romseerr scannt ihn alle
# IMPORT_SCAN_SEC Sekunden und verschiebt, was sich zuordnen laesst.
IMPORT_SHARE_HOST=/pfad/zu/romseerr-import
JD_OUTPUT=/pfad/zu/downloads

# --- Nur für den Full-Stack-Compose (RomM-Datenbank) ---
ROMM_DB_PASSWORD=
ROMM_DB_ROOT_PASSWORD=
ROMM_AUTH_SECRET_KEY=               # `openssl rand -hex 32`

# RetroAchievements (optional): Web-API-Key fuer Achievement-Angaben auf der Detailseite.
# Alternativ ueber Einstellungen -> Verbindungen setzbar.
# Archive.org: Schlüsselpaar von archive.org/account/s3.php — KEIN Passwort.
# Ohne diese Werte werden zugangsbeschränkte Titel (Sammlung `loggedin`) erkannt und
# vor dem Download abgelehnt, statt mit HTTP 401 zu scheitern.
IA_ACCESS_KEY=
IA_SECRET_KEY=
RETROACHIEVEMENTS_KEY=

# Filehoster-Kataloge (experimentell, #63): Katalog-JSON-Quellen, eine URL je Zeile
# bzw. komma-getrennt. Es wird BEWUSST keine Quelle mitgeliefert — Romseerr liefert den
# Parser, die Quellen bestimmt der Betreiber. Erwartetes Format:
#   {"name": "...", "downloads": [{"title","uris":[...],"uploadDate","fileSize"}]}
# Leer lassen = der Filehoster-Weg bleibt inaktiv. Auch ueber die Oberflaeche setzbar.
CATALOG_URLS=
# Auffrischintervall der Kataloge in Sekunden (Default 21600 = 6 h). Linkfaeule ist hier
# der Normalfall, deshalb ueberhaupt eine TTL.
ROMSEERR_CATALOG_TTL=

# --- Downloads über einen Tunnel / downloads through a tunnel ---
# Nur fuer den EIGENEN Download (Archive.org). Usenet und Filehoster laufen ueber ihre
# eigenen Clients; deren Netzwerk entscheidet dort. Leer = direkt.
# Fail-closed: gesetzt und nicht nutzbar -> der Download scheitert, KEIN Rueckfall.
DL_PROXY=

# --- Streaming-Host (#71/#137) ---
# Emulatoren, die der Browser nicht schafft (PS2, GameCube, Wii, Wii U, 3DS, Vita), laufen
# auf einem separaten Rechner; siehe contrib/streaming-host/. STREAM_URL ist die Adresse,
# die der BROWSER oeffnet, STREAM_LAUNCH der Start-Dienst, den Romseerr anspricht. Ohne
# Start-Dienst oeffnet Romseerr nur den Desktop und der Titel wird dort von Hand gestartet.
# Platz 2 ist BEWUSST ein eigenes Schluesselpaar und keine Liste: Platz 1 bleibt damit
# unveraendert, und ein zweiter Platz aendert an einer bestehenden Einrichtung nichts.
# Alles auch ueber Einstellungen -> Verbindungen setzbar.
# EN: seat 2 is a separate key pair, not a list, so seat 1 stays untouched.
STREAM_URL=
STREAM_LAUNCH=
STREAM_URL_2=
STREAM_LAUNCH_2=

# --- Cover-Quellen neben IGDB (optional) ---
# Greifen nur, wo IGDB nichts hat. Ohne diese Werte fehlen einzelne Bilder, sonst nichts.
STEAMGRIDDB_KEY=
SCREENSCRAPER_USER=
SCREENSCRAPER_PASS=

# --- Pfade IM CONTAINER / paths inside the container ---
# Gegenstueck zu den Host-Pfaden weiter oben. Nur setzen, wenn die Volumes anders liegen
# als im mitgelieferten Compose — sonst passen die Vorgaben.
# ROMSEERR_CONFIG=/config          # Datenbank, Einstellungen, Schluessel
# ROMSEERR_ROMS=/roms              # die Bibliothek
# ROMSEERR_IMPORT=/import          # Einwurfordner (Host-Seite: IMPORT_SHARE_HOST)
# JD_WATCH=/jd-watch               # Romseerrs Sicht (Host-Seite: JD_WATCH_HOST)

# --- Takt und Grenzen / intervals and limits ---
# Alle optional; die Vorgaben stehen daneben. Wer nichts misst, sollte nichts aendern.
# IMPORT_SCAN_SEC=300              # Einwurfordner: alle 5 Minuten
# ROMSEERR_WISH_INTERVAL=21600     # Wunschliste nachsuchen: alle 6 h
# ROMSEERR_PLAY_MAX_MB=            # Obergrenze fuers Spielen im Browser
# ROMSEERR_STREAM_TTL=             # wie lange eine Streaming-Sitzung gehalten wird
# ROMSEERR_WACHHUND_TAKT=          # Takt des Wachhunds ueber haengende Auftraege
# ROMSEERR_MAX_STILL_DOWNLOAD=     # ab wann ein stiller Download als haengend gilt
# ROMSEERR_MAX_STILL_IMPORT=       # dasselbe fuer den Import
# FIRMWARE_MAX_BYTES=              # Obergrenze fuer Firmware-Uploads
# ROMSEERR_HTTPS=                  # eigener HTTPS-Listener (sonst ueber die Oberflaeche)

# --- Wird beim BAUEN gesetzt, nicht von Hand / set at build time ---
# ROMSEERR_VERSION, ROMSEERR_COMMIT, ROMSEERR_BUILT_AT speisen die Herkunftsangabe unter
# „Über". Fehlen sie, sagt die Instanz ausdruecklich, dass sie ihre Herkunft nicht kennt —
# das ist richtig so und kein Wert, den man hier nachtraegt.
