# Romseerr — Konfiguration. Kopiere diese Datei nach .env und trage deine Werte ein.
# .env wird NICHT eingecheckt (siehe .gitignore).
#
# URLs: im Full-Stack-Compose zeigen sie auf die DIENSTNAMEN (z.B. http://sabnzbd:8080),
# standalone auf deine Hosts (z.B. http://192.168.1.10:8081).

# --- SABnzbd (Usenet) ---
SAB_URL=http://sabnzbd:8080
SAB_APIKEY=
SAB_CAT=roms                       # eigene, isolierte Kategorie (nicht movies/tv!)

# --- Prowlarr (nur lesend für Usenet-Suche) ---
PROWLARR_URL=http://prowlarr:9696
PROWLARR_APIKEY=
PROWLARR_CATS=1000                 # 1000 = Console

# --- IGDB (Cover, Beschreibungen, „beliebt je Konsole") ---
# https://dev.twitch.tv/console -> Anwendung registrieren
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- RomM (optional, Scan nach Import) ---
ROMM_URL=http://romm:8080
ROMM_USER=
ROMM_PASS=

# --- Benachrichtigungen (Fallback; in der Oberfläche überschreibbar) ---
DISCORD_WEBHOOK=

# --- JDownloader (Filehoster-Zweig) ---
JD_DL_BASE=/output/rom-suche        # Download-Ordner AUS SICHT des JD-Containers

# --- Port ---
PORT=8770

# --- Host-Pfade (für docker-compose volumes) ---
ROMS_LIB=/pfad/zur/romm-library/roms
SAB_COMPLETE=/pfad/zu/sabnzbd/complete/roms
JD_WATCH=/pfad/zu/jdownloader/folderwatch
JD_OUTPUT=/pfad/zu/downloads

# --- Nur für den Full-Stack-Compose (RomM-Datenbank) ---
ROMM_DB_PASSWORD=
ROMM_DB_ROOT_PASSWORD=
ROMM_AUTH_SECRET_KEY=               # `openssl rand -hex 32`

# RetroAchievements (optional): Web-API-Key fuer Achievement-Angaben auf der Detailseite.
# Alternativ ueber Einstellungen -> Verbindungen setzbar.
RETROACHIEVEMENTS_KEY=
